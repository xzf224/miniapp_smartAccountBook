:host {
  display: block;
}

.pie-wrap {
  display: flex;
  align-items: stretch;
  gap: 28rpx;
}

.donut-col {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.donut {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.donut-hole {
  position: absolute;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--color-bg-card);
  display: flex;
  align-items: center;
  justify-content: center;
}

.donut-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  width: 88rpx;
}

.donut-center-label {
  font-size: 18rpx;
  line-height: 1.3;
  color: var(--color-text-secondary);
  text-align: center;
}

.donut-center-total {
  font-size: 20rpx;
  line-height: 1.2;
  font-weight: 700;
  color: var(--color-text-primary);
  text-align: center;
}

.legend-col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding: 6rpx 0;
  box-sizing: border-box;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 10rpx;
  border-radius: 16rpx;
}

.legend-item-active {
  background: #FAF7F2;
}

.legend-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.legend-name {
  flex: 1;
  font-size: 22rpx;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.legend-pct {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
  flex-shrink: 0;
}

.legend-amount {
  font-size: 22rpx;
  color: var(--color-text-primary);
  flex-shrink: 0;
}
