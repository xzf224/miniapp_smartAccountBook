:host {
  display: block;
}

.record-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 24rpx 32rpx;
  min-height: 100rpx;
  background: var(--color-bg-card);
}

.icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.icon {
  font-size: 32rpx;
  color: #ffffff;
  font-weight: 600;
}

.info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.category {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-primary);
}

.note {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-top: 4rpx;
}

.amount {
  font-size: 32rpx;
  font-weight: 600;
}

.text-income {
  color: var(--color-income);
}

.text-expense {
  color: var(--color-expense);
}

.text-neutral {
  color: var(--color-text-secondary);
}
