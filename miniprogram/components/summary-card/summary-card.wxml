<view class="summary-card">
  <text class="card-label">本月余额</text>
  <text class="card-balance">¥ {{balance}}</text>

  <view class="stats-row">
    <view class="stat-item">
      <view class="stat-icon income-icon">↑</view>
      <text class="stat-label">收入</text>
      <text class="stat-amount">{{income}}</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <view class="stat-icon expense-icon">↓</view>
      <text class="stat-label">支出</text>
      <text class="stat-amount">{{expense}}</text>
      <view class="budget-bar-wrap" wx:if="{{expenseBudget > 0}}">
        <view class="budget-bar-track">
          <view class="budget-bar-fill {{budgetOver ? 'over' : ''}}"
                style="width: {{budgetPercent}}%"></view>
        </view>
        <text class="budget-label">{{budgetLabel}}</text>
      </view>
    </view>
  </view>
</view>
