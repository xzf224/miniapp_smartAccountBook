:host {
  display: block;
}

.summary-card {
  margin: 6rpx 24rpx 8rpx;
  background: linear-gradient(135deg, #FFB347 0%, #FF8A00 100%);
  border-radius: 28rpx;
  padding: 28rpx 28rpx 24rpx;
  box-shadow: 0 12rpx 30rpx rgba(255, 149, 0, 0.26);
  transition: background 0.3s, box-shadow 0.3s;
}

.summary-card-over {
  background: linear-gradient(135deg, #FF6B6B 0%, #E53935 100%);
  box-shadow: 0 12rpx 30rpx rgba(229, 57, 53, 0.32);
}

.card-top-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.card-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.92);
  display: block;
}

.card-days {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
}

.card-balance {
  font-size: 60rpx;
  font-weight: 700;
  color: #FFFFFF;
  display: block;
  letter-spacing: -1rpx;
  margin-bottom: 28rpx;
}

/* 预算进度 */
.budget-row {
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.budget-bar-bg {
  height: 8rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 4rpx;
  overflow: hidden;
}

.budget-bar-fill {
  height: 100%;
  background: #fff;
  border-radius: 4rpx;
  transition: width 0.3s;
}

.budget-bar-over {
  background: #FFD700;
}

@keyframes budget-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

.budget-bar-pulse {
  animation: budget-pulse 1.2s ease-in-out infinite;
}

.budget-hint {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.85);
}

.budget-hint-over {
  color: #FFD700;
  font-weight: 600;
}

.stats-row {
  display: flex;
  gap: 16rpx;
}

.stat-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 18rpx 20rpx 18rpx 26rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.16);
  backdrop-filter: blur(8rpx);
}

.stat-icon {
  width: 24rpx;
  height: 24rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.stat-head {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
}

.stat-amount {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: -0.5rpx;
}

.mixed-hint {
  margin-bottom: 14rpx;
}

.mixed-hint-text {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.7);
}
