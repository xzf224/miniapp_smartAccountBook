:host {
  display: block;
}

.summary-card {
  margin: 6rpx 24rpx 8rpx;
  background: linear-gradient(45deg, #FFB347 0%, #FF8A00 100%);
  border-radius: 28rpx;
  padding: 28rpx 28rpx 24rpx;
  box-shadow: 0 12rpx 30rpx rgba(255, 149, 0, 0.26);
}

.card-top-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.card-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.92);
  display: block;
}

.card-days {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
}

.card-balance {
  font-size: 60rpx;
  font-weight: 700;
  color: #FFFFFF;
  display: block;
  letter-spacing: -1rpx;
  margin-bottom: 28rpx;
}

.stats-row {
  display: flex;
  gap: 16rpx;
}

.stat-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 18rpx 20rpx 18rpx 26rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.16);
  backdrop-filter: blur(8rpx);
}

.stat-icon {
  width: 24rpx;
  height: 24rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.stat-head {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
}

.stat-amount {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: -0.5rpx;
}
