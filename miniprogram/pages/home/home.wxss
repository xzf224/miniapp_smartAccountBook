.page-body {
  height: 100vh;
  background: #f7f8fa;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.month-header {
  padding: 20rpx 32rpx 12rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  background: var(--color-bg-page);
}

.month-selector {
  display: flex;
  align-items: center;
}

.month-header-label {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  letter-spacing: 2rpx;
}

.month-arrow {
  width: 14rpx;
  height: 14rpx;
  border-right: 3rpx solid #353c46;
  border-bottom: 3rpx solid #353c46;
  transform: rotate(45deg) translateY(-3rpx);
  margin-left: 14rpx;
  box-sizing: border-box;
  flex-shrink: 0;
}

.header-icons {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 4rpx;
}

.icon-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
}

.header-icon {
  width: 40rpx;
  height: 40rpx;
}

.quick-actions {
  display: flex;
  justify-content: flex-start;
  width: 100%;
  margin: 20rpx 0 0;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.quick-action {
  width: 25%;
  height: 144rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.quick-action-badge {
  width: 92rpx;
  height: 92rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.badge-orange {
  background: #fff3e8;
}

.badge-blue {
  background: #edf3ff;
}

.badge-purple {
  background: #f2eefe;
}

.badge-green {
  background: #ebfaef;
}

.quick-action-icon {
  width: 52rpx;
  height: 52rpx;
}

.quick-action-label {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #8a9099;
  line-height: 1.2;
  text-align: center;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 240rpx;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 10rpx;
  display: block;
}

.empty-text {
  margin-top: 32rpx;
  color: var(--color-text-secondary);
  font-size: 26rpx;
  letter-spacing: 2rpx;
}

.day-group {
  margin: 0 24rpx 16rpx;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
}

.record-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx 12rpx;
}

.record-head-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.record-head-link {
  font-size: 22rpx;
  color: var(--color-primary);
  font-weight: 600;
}

.day-header {
  padding: 24rpx 24rpx 12rpx;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: stretch;
}

.day-meta {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.day-net-wrap {
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.day-date {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--color-text-primary);
  letter-spacing: 1rpx;
  line-height: 1.2;
}

.day-summary-label {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  line-height: 1;
}

.day-net {
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: -0.5rpx;
  line-height: 1;
  display: block;
}

.divider {
  height: 1rpx;
  background: var(--color-border);
  margin: 0 24rpx;
}

/* 待确认草稿提示卡 */
.draft-hint-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin: 16rpx 24rpx 0;
  padding: 22rpx 28rpx;
  background: var(--color-primary-light);
  border-radius: 16rpx;
  border-left: 8rpx solid var(--color-primary);
}

.draft-hint-text {
  font-size: 26rpx;
  color: #8B4513;
  font-weight: 500;
}

.draft-hint-arrow {
  font-size: 24rpx;
  color: var(--color-primary);
  font-weight: 600;
}

.record-groups {
  padding-top: 8rpx;
}

/* 本月消费分析 */
.analysis-section {
  margin: 8rpx 24rpx 8rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-card);
  padding: 28rpx 28rpx 8rpx;
}

.analysis-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  margin-bottom: 20rpx;
}

.analysis-item {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 36rpx;
}

.analysis-meta {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.analysis-name {
  font-size: 26rpx;
  color: var(--color-text-primary);
  line-height: 1.2;
}

.analysis-bar-wrap {
  height: 12rpx;
  background: #f0f0f0;
  border-radius: 6rpx;
  margin-top: 20rpx;
  margin-right: 20rpx;
  overflow: hidden;
}

.analysis-bar-fill {
  height: 100%;
  border-radius: 6rpx;
  background: var(--color-primary);
}

.analysis-amount {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  width: 144rpx;
  text-align: right;
  flex-shrink: 0;
  line-height: 1;
}

.analysis-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 16rpx 0 20rpx;
  border-top: 1rpx solid var(--color-border);
}

.analysis-toggle-text {
  font-size: 24rpx;
  color: var(--color-primary);
}

.analysis-toggle-arrow {
  width: 12rpx;
  height: 12rpx;
  border-right: 2rpx solid var(--color-primary);
  border-bottom: 2rpx solid var(--color-primary);
  transform: rotate(45deg) translateY(-2rpx);
  box-sizing: border-box;
}

.analysis-toggle-arrow-up {
  transform: rotate(-135deg) translate(-2rpx, 2rpx);
}

.page-bottom-space {
  height: calc(96rpx + env(safe-area-inset-bottom));
}
