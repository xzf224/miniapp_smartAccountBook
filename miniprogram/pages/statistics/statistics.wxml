<view class="page-body tab-page">
  <view class="page-header" style="padding-top: {{statusBarHeight}}px;">
    <view class="header-row">
      <text class="page-title">统计分析</text>
      <picker mode="multiSelector" value="{{pickerValue}}" range="{{pickerRange}}" bind:change="onPickerChange">
        <view class="month-chip">
          <text class="month-chip-text">{{year}}年{{month}}月</text>
          <text class="month-chip-arrow">⌄</text>
        </view>
      </picker>
    </view>
  </view>

  <view class="page-content">
    <view class="summary-row">
      <view class="summary-card income-card">
        <text class="summary-label income-label">本月收入</text>
        <text class="summary-value">{{income}}</text>
      </view>
      <view class="summary-card expense-card">
        <text class="summary-label expense-label">本月支出</text>
        <text class="summary-value">{{expense}}</text>
      </view>
    </view>

    <view class="type-switch">
      <view
        wx:for="{{types}}"
        wx:key="*this"
        class="type-chip {{typeIndex === index ? 'active' : ''}}"
        data-index="{{index}}"
        bind:tap="onTypeChange"
      >
        {{item}}
      </view>
    </view>

    <view class="section-card" wx:if="{{hasBarData}}">
      <view class="section-head">
        <text class="section-title">{{types[typeIndex]}}趋势</text>
        <view class="compare-tabs">
          <view
            wx:for="{{compareTabs}}"
            wx:key="mode"
            class="compare-tab {{compareMode === item.mode ? 'active' : ''}}"
            bind:tap="onCompareModeChange"
            data-mode="{{item.mode}}"
          >
            {{item.label}}
          </view>
        </view>
      </view>
      <bar-chart data="{{barData}}" barColor="{{barColor}}" />
    </view>

    <view class="section-card" wx:if="{{hasPieData}}">
      <view class="section-head section-head-single">
        <text class="section-title">{{types[typeIndex]}}分类</text>
      </view>
      <view class="category-panel">
        <view class="pie-wrap">
          <pie-chart data="{{pieData}}" total="{{typeTotalText}}" />
        </view>
        <view class="legend-list">
          <view class="legend-item" wx:for="{{rankingList}}" wx:key="category">
            <view class="legend-item-main">
              <view class="legend-dot" style="background: {{item.color}};"></view>
              <text class="legend-name">{{item.category}}</text>
            </view>
            <text class="legend-value">{{item.percentage}}%</text>
          </view>
        </view>
      </view>
    </view>

    <view class="empty-state" wx:if="{{!hasPieData && !hasBarData}}">
      <text class="empty-title">本月暂无{{types[typeIndex]}}记录</text>
      <text class="empty-desc">切换月份或先去记一笔，统计图会自动生成。</text>
    </view>
  </view>
</view>
<bottom-nav current="{{3}}" />
