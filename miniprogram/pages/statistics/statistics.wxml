<navigation-bar brand="{{true}}" back="{{false}}" />
<scroll-view scroll-y class="page-body tab-scroll">
  <view class="month-header flex-row">
    <picker mode="multiSelector" value="{{pickerValue}}" range="{{pickerRange}}" bind:change="onPickerChange">
      <view class="month-selector">
        <text class="month-header-label">{{year}}年{{month < 10 ? '0' + month : month}}月</text>
        <text class="month-selector-arrow">⌄</text>
      </view>
    </picker>
    <view class="month-header-spacer"></view>
  </view>

  <!-- 收支摘要 -->
  <view class="summary-row">
    <view
      class="summary-card income-card {{typeIndex === 1 ? 'summary-card-active summary-card-income-active' : 'summary-card-muted'}}"
      bind:tap="onSummaryTypeTap"
      data-type="收入"
    >
      <view class="summary-card-accent"></view>
      <text class="summary-label income-label">本月收入</text>
      <text class="summary-state {{typeIndex === 1 ? 'summary-state-active' : ''}}">{{typeIndex === 1 ? '当前分析' : '点按切换'}}</text>
      <text class="summary-value">{{income}}</text>
      <text class="summary-compare summary-compare-{{incomeMoMTone}}">{{incomeMoMText}}</text>
    </view>
    <view
      class="summary-card expense-card {{typeIndex === 0 ? 'summary-card-active summary-card-expense-active' : 'summary-card-muted'}}"
      bind:tap="onSummaryTypeTap"
      data-type="支出"
    >
      <view class="summary-card-accent"></view>
      <text class="summary-label expense-label">本月支出</text>
      <text class="summary-state {{typeIndex === 0 ? 'summary-state-active' : ''}}">{{typeIndex === 0 ? '当前分析' : '点按切换'}}</text>
      <text class="summary-value">{{expense}}</text>
      <text class="summary-compare summary-compare-{{expenseMoMTone}}">{{expenseMoMText}}</text>
    </view>
  </view>

  <view class="section-card budget-execution-card" wx:if="{{typeIndex === 0 && budgetExecutionVisible}}">
    <view class="section-head">
      <text class="section-title">预算执行分析</text>
      <text class="budget-status-badge budget-status-badge-{{budgetStatusTone}}">{{budgetStatusText}}</text>
    </view>
    <text class="budget-execution-hint">{{budgetHintText}}</text>
    <view class="budget-metric-grid">
      <view class="budget-metric">
        <text class="budget-metric-label">本月总预算</text>
        <text class="budget-metric-value">{{budgetTotalText}}</text>
      </view>
      <view class="budget-metric">
        <text class="budget-metric-label">本月已花</text>
        <text class="budget-metric-value">{{budgetSpentText}}</text>
      </view>
      <view class="budget-metric">
        <text class="budget-metric-label">{{budgetRemainLabel}}</text>
        <text class="budget-metric-value">{{budgetRemainText}}</text>
      </view>
      <view class="budget-metric">
        <text class="budget-metric-label">预算执行率</text>
        <text class="budget-metric-value">{{budgetExecutionPctText}}</text>
      </view>
    </view>
    <view class="budget-forecast-strip">
      <text class="budget-forecast-label">{{budgetForecastLabel}}</text>
      <text class="budget-forecast-value">{{budgetForecastText}}</text>
    </view>
    <view class="budget-variance-block" wx:if="{{budgetVarianceTop.length > 0}}">
      <view class="budget-variance-head">
        <text class="budget-variance-title">分类预算偏差 Top 3</text>
        <text class="budget-variance-sub">优先关注最接近或已经超支的分类</text>
      </view>
      <view class="budget-variance-list">
        <view class="budget-variance-item" wx:for="{{budgetVarianceTop}}" wx:key="category">
          <view class="budget-variance-top">
            <view class="budget-variance-title-wrap">
              <view class="budget-variance-dot" style="background: {{item.color}};"></view>
              <text class="budget-variance-name">{{item.category}}</text>
            </view>
            <text class="budget-variance-status budget-variance-status-{{item.status}}">{{item.varianceText}}</text>
          </view>
          <view class="budget-variance-bottom">
            <text class="budget-variance-meta">{{item.spentText}} / {{item.budgetText}}</text>
            <text class="budget-variance-meta">{{item.executionText}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 趋势柱状图 -->
  <view class="section-card" wx:if="{{hasBarData}}">
    <view class="section-head">
      <text class="section-title">{{types[typeIndex]}}趋势</text>
      <view class="compare-tabs">
        <view
          wx:for="{{compareTabs}}"
          wx:key="mode"
          class="compare-tab {{compareMode === item.mode ? 'active' : ''}}"
          bind:tap="onCompareModeChange"
          data-mode="{{item.mode}}"
        >
          {{item.label}}
        </view>
      </view>
    </view>
    <view class="trend-insights">
      <view class="insight-pill">
        <text class="insight-label">当前查看</text>
        <text class="insight-value">{{trendSelectedLabel}}</text>
        <text class="insight-meta">{{trendSelectedValueText}}</text>
      </view>
      <view class="insight-pill">
        <text class="insight-label">峰值{{compareModeLabel}}</text>
        <text class="insight-value">{{trendPeakLabel}}</text>
        <text class="insight-meta">{{trendPeakValueText}}</text>
      </view>
      <view class="insight-pill">
        <text class="insight-label">平均水平</text>
        <text class="insight-value">{{trendAverageValueText}}</text>
        <text class="insight-meta">活跃{{compareModePeriodName}} {{trendActiveCountText}}个</text>
      </view>
    </view>
    <text class="trend-tip">点按柱子可查看对应{{compareModePeriodName}}金额</text>
    <bar-chart
      data="{{barData}}"
      barColor="{{barColor}}"
      activeIndex="{{selectedBarIndex}}"
      bind:select="onBarSelect"
    />
  </view>

  <!-- 分类构成 -->
  <view class="section-card" wx:if="{{hasPieData}}">
    <view class="section-head">
      <text class="section-title">{{types[typeIndex]}}分类</text>
      <text class="section-total">{{currencySymbol}}{{typeTotalText}}</text>
    </view>

    <view class="category-focus" wx:if="{{selectedCategoryName}}">
      <view class="category-focus-top">
        <view class="category-focus-tag" style="background: {{selectedCategoryColor}};"></view>
        <text class="category-focus-label">当前关注</text>
      </view>
      <view class="category-focus-main">
        <text class="category-focus-name">{{selectedCategoryName}}</text>
        <text class="category-focus-amount">{{selectedCategoryAmountText}}</text>
      </view>
      <text class="category-focus-meta">占本月{{types[typeIndex]}} {{selectedCategoryPercentageText}}</text>
    </view>

    <view class="pie-chart-shell">
      <pie-chart
        data="{{pieData}}"
        total="{{typeTotalText}}"
        title="{{types[typeIndex]}}总额"
        activeName="{{selectedCategoryName}}"
        bind:select="onPieCategorySelect"
      />
    </view>
  </view>

  <view class="section-card category-top-card" wx:if="{{hasPieData && topCategories.length}}">
    <view class="section-head category-top-head">
      <text class="section-title">TOP 3 分类</text>
    </view>
    <view class="category-summary">
      <view
        class="category-summary-card {{selectedCategoryName === item.category ? 'category-summary-card-active' : ''}}"
        wx:for="{{topCategories}}"
        wx:key="rank"
        bind:tap="onTopCategoryTap"
        data-index="{{index}}"
      >
        <view class="category-summary-top">
          <view class="category-rank-badge" style="background: {{item.color}};">TOP {{item.rank}}</view>
          <text class="category-summary-name">{{item.category}}</text>
        </view>
        <view class="category-summary-bottom">
          <text class="category-summary-amount">{{item.amountText}}</text>
          <text class="category-summary-pct">{{item.percentageText}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!hasPieData && !hasBarData}}">
    <text class="empty-title">本月暂无{{types[typeIndex]}}记录</text>
    <text class="empty-desc">切换月份或先去记一笔，统计图会自动生成。</text>
  </view>
  <view class="page-bottom-space"></view>
</scroll-view>
<bottom-nav current="{{3}}" />
