.page-body {
  height: 100vh;
  background: var(--color-bg-page);
  box-sizing: border-box;
}

.page-bottom-space {
  height: 176rpx;
}

.month-header {
  padding: 20rpx 32rpx 12rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  background: var(--color-bg-page);
}

.month-header-spacer {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
}

.month-selector {
  display: flex;
  align-items: center;
}

.month-header-label {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  letter-spacing: 2rpx;
}

.month-selector-arrow {
  margin-left: 16rpx;
  font-size: 30rpx;
  color: #353c46;
  line-height: 1;
  transform: translateY(-5rpx);
}

/* 收支摘要 */
.summary-row {
  display: flex;
  gap: 16rpx;
  margin: 6rpx 24rpx 16rpx;
}

.summary-card {
  flex: 1;
  position: relative;
  overflow: hidden;
  border-radius: var(--radius-card);
  padding: 24rpx;
  border: 2rpx solid transparent;
  transition: transform 0.2s ease, box-shadow 0.2s ease, opacity 0.2s ease, border-color 0.2s ease;
}

.income-card {
  background: linear-gradient(180deg, #EEF9F0 0%, #E5F6E8 100%);
}

.expense-card {
  background: linear-gradient(180deg, #FFF7EC 0%, #FFF0DB 100%);
}

.summary-card-accent {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 8rpx;
  opacity: 0;
  transition: opacity 0.2s ease;
}

.income-card .summary-card-accent {
  background: linear-gradient(90deg, #27AE60 0%, #52C41A 100%);
}

.expense-card .summary-card-accent {
  background: linear-gradient(90deg, #FF8A00 0%, #FF6A3D 100%);
}

.summary-label {
  display: block;
  font-size: 22rpx;
  line-height: 1.4;
}

.summary-state {
  margin-top: 8rpx;
  display: inline-flex;
  align-items: center;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  line-height: 1.2;
  color: var(--color-text-secondary);
  background: rgba(255, 255, 255, 0.56);
}

.summary-state-active {
  color: #FFFFFF;
  font-weight: 600;
  background: rgba(15, 23, 42, 0.16);
}

.income-label {
  color: var(--color-income);
}

.expense-label {
  color: var(--color-expense);
}

.summary-value {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  margin-top: 12rpx;
  display: block;
}

.summary-compare {
  display: block;
  margin-top: 10rpx;
  font-size: 20rpx;
  line-height: 1.3;
}

.summary-compare-positive {
  color: #2f855a;
}

.summary-compare-negative {
  color: #d94841;
}

.summary-compare-neutral {
  color: var(--color-text-secondary);
}

.summary-card-active {
  box-shadow: 0 16rpx 32rpx rgba(15, 23, 42, 0.1);
  transform: translateY(-4rpx);
}

.summary-card-active .summary-card-accent {
  opacity: 1;
}

.summary-card-active .summary-value {
  color: #141A22;
}

.summary-card-income-active {
  border-color: rgba(46, 204, 113, 0.28);
  box-shadow: 0 16rpx 32rpx rgba(46, 204, 113, 0.16);
}

.summary-card-expense-active {
  border-color: rgba(255, 138, 0, 0.28);
  box-shadow: 0 16rpx 32rpx rgba(255, 138, 0, 0.16);
}

.summary-card-muted {
  opacity: 0.78;
}

.summary-card-muted .summary-value {
  color: rgba(26, 26, 26, 0.7);
}

.summary-card-muted .summary-label {
  opacity: 0.88;
}

/* 通用卡片 */
.section-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-card);
  margin: 0 24rpx 16rpx;
  padding: 14rpx 20rpx 20rpx;
  box-sizing: border-box;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  padding: 0;
}

.section-total {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.budget-execution-card {
  padding-top: 18rpx;
}

.budget-status-badge {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.budget-status-badge-normal {
  background: rgba(46, 204, 113, 0.12);
  color: #1f8f57;
}

.budget-status-badge-warning {
  background: rgba(255, 138, 0, 0.12);
  color: #d97706;
}

.budget-status-badge-danger {
  background: rgba(250, 81, 81, 0.12);
  color: #d94841;
}

.budget-status-badge-neutral {
  background: rgba(148, 163, 184, 0.12);
  color: #64748b;
}

.budget-execution-hint {
  display: block;
  margin-bottom: 16rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--color-text-secondary);
}

.budget-metric-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.budget-metric {
  width: calc(50% - 6rpx);
  box-sizing: border-box;
  padding: 18rpx;
  border-radius: 20rpx;
  background: #faf7f2;
}

.budget-metric-label {
  display: block;
  font-size: 20rpx;
  line-height: 1.3;
  color: var(--color-text-secondary);
}

.budget-metric-value {
  display: block;
  margin-top: 10rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  line-height: 1.25;
}

.budget-forecast-strip {
  margin-top: 14rpx;
  padding: 16rpx 18rpx;
  border-radius: 20rpx;
  background: linear-gradient(180deg, #fffaf3 0%, #ffffff 100%);
  border: 1rpx solid rgba(255, 138, 0, 0.1);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.budget-forecast-label {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.budget-forecast-value {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.budget-variance-block {
  margin-top: 18rpx;
}

.budget-variance-head {
  margin-bottom: 12rpx;
}

.budget-variance-title {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.budget-variance-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--color-text-secondary);
}

.budget-variance-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.budget-variance-item {
  padding: 18rpx;
  border-radius: 20rpx;
  background: #faf7f2;
}

.budget-variance-top,
.budget-variance-bottom,
.budget-variance-title-wrap {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.budget-variance-title-wrap {
  justify-content: flex-start;
  gap: 10rpx;
  min-width: 0;
  flex: 1;
}

.budget-variance-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.budget-variance-name {
  min-width: 0;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.budget-variance-status {
  margin-left: 12rpx;
  font-size: 22rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.budget-variance-status-normal {
  color: #2f855a;
}

.budget-variance-status-warning {
  color: #d97706;
}

.budget-variance-status-danger {
  color: #d94841;
}

.budget-variance-bottom {
  margin-top: 10rpx;
}

.budget-variance-meta {
  font-size: 20rpx;
  color: var(--color-text-secondary);
}

/* 对比模式标签 */
.compare-tabs {
  display: flex;
  align-items: center;
  padding: 4rpx;
  border-radius: 999rpx;
  background: var(--color-bg-page);
}

.compare-tab {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  min-width: 56rpx;
  text-align: center;
  line-height: 1.2;
}

.compare-tab.active {
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-weight: 600;
}

.trend-insights {
  display: flex;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.insight-pill {
  flex: 1;
  min-width: 0;
  padding: 16rpx 18rpx;
  border-radius: 20rpx;
  background: #FAF7F2;
}

.insight-label {
  display: block;
  font-size: 20rpx;
  color: var(--color-text-secondary);
  line-height: 1.2;
}

.insight-value {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.25;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.insight-meta {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--color-text-secondary);
  line-height: 1.3;
}

.trend-tip {
  display: block;
  margin-bottom: 12rpx;
  font-size: 20rpx;
  color: var(--color-text-secondary);
}

.category-summary {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.pie-chart-shell {
  display: block;
  box-sizing: border-box;
}

.category-top-card {
  padding-top: 16rpx;
  padding-bottom: 52rpx;
}

.category-top-head {
  margin-bottom: 14rpx;
}

.category-focus {
  margin-bottom: 14rpx;
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
  background: #FAF7F2;
}

.category-focus-top,
.category-focus-main {
  display: flex;
  align-items: center;
}

.category-focus-top {
  gap: 10rpx;
}

.category-focus-main {
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 10rpx;
}

.category-focus-tag {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.category-focus-label {
  font-size: 20rpx;
  color: var(--color-text-secondary);
}

.category-focus-name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.category-focus-amount {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  flex-shrink: 0;
}

.category-focus-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--color-text-secondary);
}

.category-summary-card {
  min-height: 116rpx;
  padding: 22rpx 20rpx;
  border-radius: 22rpx;
  background: #FAF7F2;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.category-summary-card-active {
  background: rgba(255, 138, 0, 0.1);
}

.category-summary-top,
.category-summary-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.category-summary-bottom {
  margin-top: 12rpx;
}

.category-rank-badge {
  min-width: 78rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  font-weight: 700;
  color: #fff;
  text-align: center;
  box-sizing: border-box;
}

.category-summary-name {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.category-summary-amount {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.category-summary-pct {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

/* 分类排行列表 */
.rank-list {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.rank-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.rank-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
  width: 120rpx;
  flex-shrink: 0;
}

.rank-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 4rpx;
  flex-shrink: 0;
}

.rank-name {
  font-size: 24rpx;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rank-right {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.rank-bar-wrap {
  flex: 1;
  height: 10rpx;
  background: #F0F0F0;
  border-radius: 5rpx;
  overflow: hidden;
}

.rank-bar-fill {
  height: 100%;
  border-radius: 5rpx;
  min-width: 4rpx;
}

.rank-pct {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  width: 60rpx;
  text-align: right;
  flex-shrink: 0;
}

.rank-amount {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  width: 110rpx;
  text-align: right;
  flex-shrink: 0;
}

/* 空状态 */
.empty-state {
  margin: 16rpx 24rpx;
  padding: 72rpx 32rpx;
  border-radius: var(--radius-card);
  background: var(--color-bg-card);
  text-align: center;
}

.empty-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.empty-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--color-text-secondary);
}
