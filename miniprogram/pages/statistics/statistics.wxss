.page-body {
  height: 100vh;
  background: var(--color-bg-page);
  box-sizing: border-box;
}

.page-bottom-space {
  height: 176rpx;
}

.month-header {
  padding: 20rpx 32rpx 12rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  background: var(--color-bg-page);
}

.month-header-spacer {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
}

.month-selector {
  display: flex;
  align-items: center;
}

.month-header-label {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  letter-spacing: 2rpx;
}

.month-selector-arrow {
  margin-left: 16rpx;
  font-size: 30rpx;
  color: #353c46;
  line-height: 1;
  transform: translateY(-5rpx);
}

/* 收支摘要 */
.summary-row {
  display: flex;
  gap: 16rpx;
  margin: 6rpx 24rpx 16rpx;
}

.summary-card {
  flex: 1;
  border-radius: var(--radius-card);
  padding: 24rpx;
  transition: transform 0.2s ease, box-shadow 0.2s ease, opacity 0.2s ease;
}

.income-card {
  background: #E8F5E9;
}

.expense-card {
  background: #FFF3E0;
}

.summary-label {
  display: block;
  font-size: 22rpx;
  line-height: 1.4;
}

.summary-state {
  display: block;
  margin-top: 8rpx;
  font-size: 18rpx;
  line-height: 1.2;
  color: var(--color-text-secondary);
}

.income-label {
  color: var(--color-income);
}

.expense-label {
  color: var(--color-expense);
}

.summary-value {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  margin-top: 12rpx;
  display: block;
}

.summary-card-active {
  box-shadow: 0 12rpx 28rpx rgba(15, 23, 42, 0.08);
  transform: translateY(-2rpx);
}

.summary-card-muted {
  opacity: 0.72;
}

/* 通用卡片 */
.section-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-card);
  margin: 0 24rpx 16rpx;
  padding: 14rpx 20rpx 20rpx;
  box-sizing: border-box;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  padding: 0;
}

.section-total {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

/* 对比模式标签 */
.compare-tabs {
  display: flex;
  align-items: center;
  padding: 4rpx;
  border-radius: 999rpx;
  background: var(--color-bg-page);
}

.compare-tab {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  min-width: 56rpx;
  text-align: center;
  line-height: 1.2;
}

.compare-tab.active {
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-weight: 600;
}

.trend-insights {
  display: flex;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.insight-pill {
  flex: 1;
  min-width: 0;
  padding: 16rpx 18rpx;
  border-radius: 20rpx;
  background: #FAF7F2;
}

.insight-label {
  display: block;
  font-size: 20rpx;
  color: var(--color-text-secondary);
  line-height: 1.2;
}

.insight-value {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.25;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.insight-meta {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--color-text-secondary);
  line-height: 1.3;
}

.trend-tip {
  display: block;
  margin-bottom: 12rpx;
  font-size: 20rpx;
  color: var(--color-text-secondary);
}

.category-summary {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.pie-chart-shell {
  display: block;
  box-sizing: border-box;
}

.category-top-card {
  padding-top: 16rpx;
  padding-bottom: 52rpx;
}

.category-top-head {
  margin-bottom: 14rpx;
}

.category-focus {
  margin-bottom: 14rpx;
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
  background: #FAF7F2;
}

.category-focus-top,
.category-focus-main {
  display: flex;
  align-items: center;
}

.category-focus-top {
  gap: 10rpx;
}

.category-focus-main {
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 10rpx;
}

.category-focus-tag {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.category-focus-label {
  font-size: 20rpx;
  color: var(--color-text-secondary);
}

.category-focus-name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.category-focus-amount {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  flex-shrink: 0;
}

.category-focus-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--color-text-secondary);
}

.category-summary-card {
  min-height: 116rpx;
  padding: 22rpx 20rpx;
  border-radius: 22rpx;
  background: #FAF7F2;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.category-summary-card-active {
  background: rgba(255, 138, 0, 0.1);
}

.category-summary-top,
.category-summary-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.category-summary-bottom {
  margin-top: 12rpx;
}

.category-rank-badge {
  min-width: 78rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  font-weight: 700;
  color: #fff;
  text-align: center;
  box-sizing: border-box;
}

.category-summary-name {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.category-summary-amount {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.category-summary-pct {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

/* 分类排行列表 */
.rank-list {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.rank-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.rank-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
  width: 120rpx;
  flex-shrink: 0;
}

.rank-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 4rpx;
  flex-shrink: 0;
}

.rank-name {
  font-size: 24rpx;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rank-right {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.rank-bar-wrap {
  flex: 1;
  height: 10rpx;
  background: #F0F0F0;
  border-radius: 5rpx;
  overflow: hidden;
}

.rank-bar-fill {
  height: 100%;
  border-radius: 5rpx;
  min-width: 4rpx;
}

.rank-pct {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  width: 60rpx;
  text-align: right;
  flex-shrink: 0;
}

.rank-amount {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  width: 110rpx;
  text-align: right;
  flex-shrink: 0;
}

/* 空状态 */
.empty-state {
  margin: 16rpx 24rpx;
  padding: 72rpx 32rpx;
  border-radius: var(--radius-card);
  background: var(--color-bg-card);
  text-align: center;
}

.empty-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.empty-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--color-text-secondary);
}
