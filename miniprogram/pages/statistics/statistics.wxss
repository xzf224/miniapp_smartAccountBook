.stat-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--color-bg-page);
}

/* 顶部标题栏 */
.page-header {
  background: var(--color-bg-card);
  padding: 0 32rpx 20rpx;
  flex-shrink: 0;
}

.header-row {
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.page-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.month-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 18rpx;
  border-radius: 32rpx;
  background: var(--color-bg-page);
}

.month-chip-text {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--color-text-secondary);
  line-height: 1;
}

.month-chip-arrow {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1;
  transform: translateY(-2rpx);
}

/* 滚动区 */
.page-scroll {
  flex: 1;
  height: 0;
  padding-bottom: calc(148rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 收支摘要 */
.summary-row {
  display: flex;
  gap: 16rpx;
  margin: 16rpx 24rpx;
}

.summary-card {
  flex: 1;
  border-radius: var(--radius-card);
  padding: 24rpx;
}

.income-card {
  background: #E8F5E9;
}

.expense-card {
  background: #FFF3E0;
}

.summary-label {
  display: block;
  font-size: 22rpx;
  line-height: 1.4;
}

.income-label {
  color: var(--color-income);
}

.expense-label {
  color: var(--color-expense);
}

.summary-value {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  margin-top: 8rpx;
  display: block;
}

/* 类型切换 */
.type-switch {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  margin: 0 24rpx 16rpx;
}

.type-chip {
  padding: 10rpx 32rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  background: var(--color-bg-card);
}

.type-chip.active {
  background: var(--color-primary);
  color: #fff;
  font-weight: 600;
}

/* 通用卡片 */
.section-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-card);
  margin: 0 24rpx 16rpx;
  padding: 28rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.section-total {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

/* 对比模式标签 */
.compare-tabs {
  display: flex;
  align-items: center;
  padding: 4rpx;
  border-radius: 999rpx;
  background: var(--color-bg-page);
}

.compare-tab {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  min-width: 56rpx;
  text-align: center;
  line-height: 1.2;
}

.compare-tab.active {
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-weight: 600;
}

/* 分类排行列表 */
.rank-list {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.rank-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.rank-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
  width: 120rpx;
  flex-shrink: 0;
}

.rank-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 4rpx;
  flex-shrink: 0;
}

.rank-name {
  font-size: 24rpx;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rank-right {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.rank-bar-wrap {
  flex: 1;
  height: 10rpx;
  background: #F0F0F0;
  border-radius: 5rpx;
  overflow: hidden;
}

.rank-bar-fill {
  height: 100%;
  border-radius: 5rpx;
  min-width: 4rpx;
}

.rank-pct {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  width: 60rpx;
  text-align: right;
  flex-shrink: 0;
}

.rank-amount {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  width: 110rpx;
  text-align: right;
  flex-shrink: 0;
}

/* 空状态 */
.empty-state {
  margin: 16rpx 24rpx;
  padding: 72rpx 32rpx;
  border-radius: var(--radius-card);
  background: var(--color-bg-card);
  text-align: center;
}

.empty-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.empty-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--color-text-secondary);
}
