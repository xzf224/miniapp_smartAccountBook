.page-body {
  min-height: 100vh;
  background: #f5f6f8;
}

.month-header {
  padding: 20rpx 24rpx 8rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.month-header-label {
  font-size: 36rpx;
  font-weight: 600;
  color: #252a31;
}

.month-picker {
  display: flex;
  align-items: center;
  padding: 0 16rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background: #fff;
}

.month-picker-text {
  font-size: 22rpx;
  color: #8d95a2;
  margin-right: 8rpx;
}

.month-picker-icon {
  width: 28rpx;
  height: 28rpx;
}

.summary-row {
  display: flex;
  gap: 16rpx;
  margin: 16rpx 24rpx 0;
}

.summary-box {
  flex: 1;
  padding: 22rpx 20rpx;
  border-radius: 20rpx;
}

.income-box {
  background: #e7f5ef;
}

.expense-box {
  background: #fdeeee;
}

.summary-label {
  display: block;
  font-size: 20rpx;
  color: #86ae98;
}

.expense-box .summary-label {
  color: #f28b82;
}

.summary-value {
  display: block;
  margin-top: 10rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #252a31;
}

.type-tabs {
  margin: 20rpx 24rpx 0;
  padding: 8rpx;
  background: #fff;
  border-radius: 20rpx;
}

.type-tab {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 16rpx;
  font-size: 24rpx;
  color: #8d95a2;
}

.type-tab.active {
  background: #fff3e6;
  color: #ff8a00;
  font-weight: 600;
}

.section-card {
  margin: 20rpx 24rpx 0;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #fff;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #252a31;
}

.category-panel {
  display: flex;
  align-items: center;
}

.pie-wrap {
  width: 240rpx;
}

.legend {
  flex: 1;
  margin-left: 8rpx;
}

.legend-item {
  align-items: center;
  padding: 10rpx 0;
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.legend-name {
  font-size: 24rpx;
  color: #555f6d;
}

.legend-pct {
  font-size: 24rpx;
  color: #8d95a2;
}

.rank-item {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f1f3;
}

.rank-item:last-child {
  border-bottom: none;
}

.rank-row {
  align-items: center;
  justify-content: space-between;
}

.rank-left {
  align-items: center;
}

.rank-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 7rpx;
  margin-right: 10rpx;
  flex-shrink: 0;
}

.rank-name {
  font-size: 28rpx;
  color: #252a31;
}

.rank-amount {
  font-size: 28rpx;
  font-weight: 600;
  color: #252a31;
}

.rank-row-meta {
  justify-content: space-between;
  margin: 10rpx 0 12rpx;
}

.rank-pct {
  font-size: 22rpx;
  color: #8d95a2;
}

.rank-bar-track {
  height: 8rpx;
  background: #f0f1f3;
  border-radius: 999rpx;
  overflow: hidden;
}

.rank-bar-fill {
  height: 100%;
  transition: width 0.3s;
  border-radius: 999rpx;
}

.budget-tip-text {
  font-size: 22rpx;
  color: #8d95a2;
}

.budget-tip-text.over {
  color: #ff6b6b;
}

.compare-tabs {
  background: #f5f6f8;
  border-radius: 999rpx;
  padding: 4rpx;
}

.compare-tab {
  min-width: 52rpx;
  padding: 8rpx 18rpx;
  font-size: 24rpx;
  color: #8d95a2;
  border-radius: 999rpx;
  text-align: center;
}

.compare-tab.active {
  background: #fff;
  box-shadow: 0 6rpx 14rpx rgba(0, 0, 0, 0.06);
  color: #fff;
  font-weight: 600;
  color: #ff8a00;
}

.text-expense {
  color: #ff6b6b;
}

.empty-text {
  display: block;
  padding: 120rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #8d95a2;
}
