.page-body {
  background: var(--color-bg-page);
  min-height: 100vh;
}

.page-header {
  background: var(--color-bg-card);
  padding: 0 32rpx 20rpx;
}

.header-row {
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.page-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.month-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 18rpx;
  border-radius: 32rpx;
  background: var(--color-bg-page);
}

.month-chip-text {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--color-text-secondary);
  line-height: 1;
}

.month-chip-arrow {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1;
  transform: translateY(-2rpx);
}

.page-content {
  padding: 8rpx 0 0;
}

/* 收入/支出摘要卡片横排 */
.summary-row {
  display: flex;
  gap: 16rpx;
  margin: 16rpx 24rpx;
}

.summary-card {
  flex: 1;
  border-radius: var(--radius-card);
  padding: 24rpx;
}

.income-card {
  background: #E8F5E9;
}

.expense-card {
  background: #FFF3E0;
}

.summary-label {
  display: block;
  font-size: 22rpx;
  line-height: 1.4;
}

.income-label {
  color: var(--color-income);
}

.expense-label {
  color: var(--color-expense);
}

.summary-value {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  margin-top: 8rpx;
  display: block;
}

/* 趋势类型切换 */
.type-switch {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  margin: 0 24rpx 16rpx;
}

.type-chip {
  padding: 10rpx 32rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  background: var(--color-bg-card);
}

.type-chip.active {
  background: var(--color-primary);
  color: #fff;
  font-weight: 600;
}

/* 图表卡片 */
.section-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-card);
  margin: 0 24rpx 16rpx;
  padding: 28rpx;
  box-sizing: border-box;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.section-head-single {
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.2;
}

.compare-tabs {
  display: flex;
  align-items: center;
  padding: 4rpx;
  border-radius: 999rpx;
  background: var(--color-bg-page);
  flex-shrink: 0;
}

/* 周/月/年 compare tabs */
.compare-tab {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  min-width: 56rpx;
  text-align: center;
  line-height: 1.2;
}

.compare-tab.active {
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-weight: 600;
}

.category-panel {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.pie-wrap {
  width: 180rpx;
  flex-shrink: 0;
}

.legend-list {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.legend-item-main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.legend-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 4rpx;
  flex-shrink: 0;
}

.legend-name {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: var(--color-text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.legend-value {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1;
}

.empty-state {
  margin: 16rpx 24rpx;
  padding: 72rpx 32rpx;
  border-radius: var(--radius-card);
  background: var(--color-bg-card);
  text-align: center;
}

.empty-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.empty-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--color-text-secondary);
}
