<navigation-bar brand="{{true}}" back="{{false}}" />
<scroll-view scroll-y class="page-body tab-scroll">
  <view class="month-header">
    <picker mode="multiSelector" value="{{pickerValue}}" range="{{pickerRange}}" bind:change="onPickerChange">
      <view class="month-selector">
        <text class="month-header-label">{{year}}年{{month < 10 ? '0' + month : month}}月</text>
        <text class="month-selector-arrow">⌄</text>
      </view>
    </picker>
    <view class="nav-action" bind:tap="onOpenBudgetSetting">
      <image class="nav-action-icon" src="/images/settings-2.png" mode="aspectFit" />
    </view>
  </view>
  <view class="budget-card">
    <view class="budget-card-top">
      <text class="budget-card-title">{{month}}月总预算</text>
      <text class="budget-card-days">剩余{{daysLeft}}天</text>
    </view>
    <view class="budget-main-row">
      <text class="budget-main-amount">¥{{expenseText}}</text>
      <text class="budget-main-sub">/ ¥{{totalBudgetText}}</text>
    </view>
    <view class="progress-track">
      <view class="progress-fill {{isOverBudget ? 'progress-fill-over' : ''}}" style="width: {{progressWidth}}%;"></view>
    </view>
    <view class="budget-foot-row">
      <text class="budget-foot-left {{isOverBudget ? 'budget-foot-left-over' : ''}}">已用 {{progress}}%</text>
      <text class="budget-foot-right {{isOverBudget ? 'budget-foot-right-over' : ''}}">{{remainLabel}} ¥{{remainText}}</text>
    </view>
  </view>

  <view class="section-row">
    <text class="section-title">分类预算</text>
    <text class="section-add" bind:tap="onOpenBudgetSetting">＋ 添加</text>
  </view>

  <view class="budget-list" wx:if="{{items.length > 0}}">
    <view class="budget-item" wx:for="{{items}}" wx:key="category">
      <view class="budget-item-head">
        <view class="budget-item-main">
          <view class="budget-item-icon" style="background: {{item.iconBg}}; color: {{item.color}};">{{item.iconText}}</view>
          <view class="budget-item-copy">
            <view class="budget-item-row">
              <text class="budget-item-name">{{item.category}}</text>
              <text class="budget-item-percent {{item.overBudget ? 'budget-item-percent-over' : ''}}" style="color: {{item.accentColor}};">{{item.percent}}%</text>
            </view>
            <text class="budget-item-sub">¥{{item.spentText}} / ¥{{item.budgetText}}</text>
          </view>
        </view>
      </view>
      <view class="budget-item-track">
        <view class="budget-item-fill {{item.overBudget ? 'budget-item-fill-over' : ''}}" style="width: {{item.progressWidth}}%; background: {{item.accentColor}};"></view>
      </view>
    </view>
  </view>
  <view class="empty-tip" wx:if="{{items.length === 0}}">还没有分类预算，点击右上角添加</view>
</scroll-view>
<bottom-nav current="{{1}}" />
