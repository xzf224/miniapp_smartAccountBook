.page-body {
  height: 100vh;
  background: #f6f7f9;
  box-sizing: border-box;
}

.month-header {
  padding: 20rpx 32rpx 12rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  background: var(--color-bg-page);
}

.month-selector {
  display: flex;
  align-items: center;
}

.month-header-label {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  letter-spacing: 2rpx;
}

.month-selector-arrow {
  margin-left: 16rpx;
  font-size: 30rpx;
  color: #353c46;
  line-height: 1;
  transform: translateY(-5rpx);
}

.nav-action {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-action-icon {
  width: 34rpx;
  height: 34rpx;
}

.budget-card {
  margin: 14rpx 24rpx 16rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-card);
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}

.budget-card-top,
.budget-foot-row,
.budget-item-row,
.section-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.budget-card-title,
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.budget-card-days,
.budget-item-sub {
  font-size: 22rpx;
  color: #9ca3af;
}

.budget-card-days {
  font-weight: 400;
}

.budget-main-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-top: 18rpx;
}

.budget-main-amount {
  font-size: 52rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.budget-main-sub {
  font-size: 28rpx;
  color: #9ca3af;
}

.progress-track {
  height: 12rpx;
  background: #f0f0f0;
  border-radius: 6rpx;
  margin: 20rpx 0 12rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: var(--color-primary);
  border-radius: 6rpx;
}

.progress-fill-over {
  background: var(--color-expense);
}

.budget-foot-row {
  margin-top: 18rpx;
}

.budget-foot-left,
.budget-foot-right {
  font-size: 22rpx;
}

.budget-foot-left {
  color: var(--color-primary);
  font-weight: 500;
}

.budget-foot-right {
  color: #9ca3af;
}

.budget-foot-left-over,
.budget-foot-right-over {
  color: #fa5151;
}

.section-row {
  margin: 24rpx 32rpx 16rpx;
  justify-content: space-between;
}

.section-add {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.budget-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.budget-item {
  background: var(--color-bg-card);
  border-radius: var(--radius-card);
  margin: 0 24rpx 12rpx;
  padding: 24rpx 28rpx;
}

.budget-item-head,
.budget-item-main,
.budget-item-copy {
  display: flex;
}

.budget-item-main {
  align-items: center;
  width: 100%;
}

.budget-item-copy {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
  flex-direction: column;
}

.budget-item-icon {
  width: 52rpx;
  height: 52rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 700;
}

.budget-item-row {
  width: 100%;
}

.budget-item-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.budget-item-percent {
  font-size: 28rpx;
  font-weight: 700;
}

.budget-item-percent-over {
  color: #fa5151;
}

.budget-item-sub {
  margin-top: 8rpx;
}

.budget-item-track {
  height: 8rpx;
  background: #f0f0f0;
  border-radius: 4rpx;
  margin-top: 16rpx;
  overflow: hidden;
}

.budget-item-fill {
  height: 100%;
  border-radius: 999rpx;
}

.budget-item-fill-over {
  background: #fa5151;
}

.empty-tip {
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  text-align: center;
  color: #9ca3af;
  font-size: 24rpx;
  box-shadow: 0 10rpx 30rpx rgba(15, 23, 42, 0.03);
}
