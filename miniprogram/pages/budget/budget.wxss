.page-body {
  height: 100vh;
  background: #f6f7f9;
  box-sizing: border-box;
}

.page-bottom-space {
  height: 176rpx;
}

.month-header {
  padding: 20rpx 32rpx 12rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  background: var(--color-bg-page);
}

.month-selector {
  display: flex;
  align-items: center;
}

.month-header-label {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  letter-spacing: 2rpx;
}

.month-selector-arrow {
  margin-left: 16rpx;
  font-size: 30rpx;
  color: #353c46;
  line-height: 1;
  transform: translateY(-5rpx);
}

.nav-action {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-action-icon {
  width: 34rpx;
  height: 34rpx;
}

.budget-card {
  margin: 14rpx 24rpx 16rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-card);
  padding: 28rpx;
  box-shadow: 0 10rpx 24rpx rgba(15, 23, 42, 0.05);
  border: 2rpx solid transparent;
}

.budget-card-normal {
  background: linear-gradient(180deg, #fffaf3 0%, #ffffff 100%);
  border-color: rgba(255, 138, 0, 0.1);
}

.budget-card-warning {
  background: linear-gradient(180deg, #fff8ef 0%, #ffffff 100%);
  border-color: rgba(255, 138, 0, 0.18);
}

.budget-card-danger {
  background: linear-gradient(180deg, #fff5f5 0%, #ffffff 100%);
  border-color: rgba(250, 81, 81, 0.16);
}

.budget-card-neutral {
  background: linear-gradient(180deg, #fafbfc 0%, #ffffff 100%);
  border-color: rgba(148, 163, 184, 0.16);
}

.budget-card-top,
.budget-foot-row,
.budget-item-row,
.section-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.budget-card-title,
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a1a;
  padding: 0;
}

.budget-card-days,
.budget-item-sub {
  font-size: 22rpx;
  color: #9ca3af;
}

.budget-card-badge {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.budget-card-badge-normal {
  background: rgba(76, 175, 80, 0.12);
  color: #2e7d32;
}

.budget-card-badge-warning {
  background: rgba(255, 138, 0, 0.14);
  color: var(--color-primary);
}

.budget-card-badge-danger {
  background: rgba(250, 81, 81, 0.12);
  color: #fa5151;
}

.budget-card-badge-neutral {
  background: rgba(148, 163, 184, 0.14);
  color: #64748b;
}

.budget-card-label {
  display: block;
  margin-top: 18rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.budget-card-days {
  display: block;
  margin-top: 10rpx;
  font-weight: 400;
  line-height: 1.5;
}

.budget-main-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-top: 10rpx;
}

.budget-main-amount {
  font-size: 52rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.budget-metrics-row {
  display: flex;
  gap: 14rpx;
  margin-top: 20rpx;
}

.budget-metric-card {
  flex: 1;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: #faf7f2;
}

.budget-metric-card-normal {
  background: rgba(255, 138, 0, 0.08);
}

.budget-metric-card-warning {
  background: rgba(255, 138, 0, 0.1);
}

.budget-metric-card-danger {
  background: rgba(250, 81, 81, 0.08);
}

.budget-metric-card-neutral {
  background: rgba(148, 163, 184, 0.08);
}

.budget-metric-label {
  display: block;
  font-size: 20rpx;
  color: var(--color-text-secondary);
}

.budget-metric-value {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.progress-track {
  height: 12rpx;
  background: #f0f0f0;
  border-radius: 6rpx;
  margin: 22rpx 0 12rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: var(--color-primary);
  border-radius: 6rpx;
}

.progress-fill-over {
  background: var(--color-expense);
}

.budget-foot-row {
  margin-top: 18rpx;
}

.budget-foot-left,
.budget-foot-right {
  font-size: 22rpx;
}

.budget-foot-left {
  color: var(--color-primary);
  font-weight: 500;
}

.budget-foot-right {
  color: #9ca3af;
}

.budget-foot-left-over,
.budget-foot-right-over {
  color: #fa5151;
}

.section-row {
  margin: 24rpx 32rpx 16rpx;
  justify-content: space-between;
}

.section-add {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-primary);
  background: rgba(255, 138, 0, 0.12);
}

.budget-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding-bottom: 12rpx;
}

.budget-item {
  background: var(--color-bg-card);
  border-radius: var(--radius-card);
  margin: 0 24rpx 4rpx;
  padding: 0;
  box-shadow: 0 8rpx 22rpx rgba(15, 23, 42, 0.04);
  overflow: hidden;
}

.budget-item-priority {
  box-shadow: 0 10rpx 24rpx rgba(15, 23, 42, 0.05);
}

.budget-item-over {
  box-shadow: 0 12rpx 26rpx rgba(250, 81, 81, 0.08);
}

.budget-item-head,
.budget-item-main,
.budget-item-copy {
  display: flex;
}

.budget-item-main {
  align-items: center;
  width: 100%;
  padding: 24rpx 28rpx;
  border-radius: var(--radius-card);
  box-sizing: border-box;
  position: relative;
}

.budget-item-main-warning {
  border-left: 8rpx solid rgba(255, 138, 0, 0.28);
}

.budget-item-main-danger {
  border-left: 8rpx solid rgba(250, 81, 81, 0.3);
}

.budget-item-accent {
  width: 8rpx;
  height: 64rpx;
  border-radius: 999rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.budget-item-copy {
  flex: 1;
  min-width: 0;
  flex-direction: column;
  margin-left: 20rpx;
  padding-right: 8rpx;
}

.budget-item-icon {
  width: 52rpx;
  height: 52rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 700;
}

.budget-item-row {
  width: 100%;
}

.budget-item-title-group,
.budget-item-meta-row {
  display: flex;
  align-items: center;
}

.budget-item-title-group {
  flex: 1;
  min-width: 0;
  gap: 10rpx;
}

.budget-item-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.budget-item-rank {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.budget-item-percent {
  font-size: 28rpx;
  font-weight: 700;
}

.budget-item-percent-over {
  color: #fa5151;
}

.budget-item-sub {
  margin-top: 0;
}

.budget-item-meta-row {
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 8rpx;
}

.budget-item-status {
  font-size: 20rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.budget-item-status-normal {
  color: var(--color-primary);
}

.budget-item-status-warning {
  color: #d97706;
}

.budget-item-status-danger {
  color: #fa5151;
}

.budget-item-track {
  height: 8rpx;
  background: #f0f0f0;
  border-radius: 4rpx;
  margin: 0 28rpx 24rpx;
  overflow: hidden;
}

.budget-item-fill {
  height: 100%;
  border-radius: 999rpx;
}

.budget-item-fill-over {
  background: #fa5151;
}

.empty-tip {
  background: #fff;
  border-radius: 24rpx;
  margin: 0 24rpx;
  padding: 40rpx 32rpx;
  text-align: center;
  color: #9ca3af;
  font-size: 24rpx;
  box-shadow: 0 8rpx 22rpx rgba(15, 23, 42, 0.04);
}
