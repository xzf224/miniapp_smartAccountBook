.page-body {
  height: 100vh;
  background: var(--color-bg-page);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.draft-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-card);
  margin: 24rpx 24rpx 0;
  padding: 28rpx 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.draft-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.draft-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.draft-date {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.draft-meta {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.draft-type {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.type-expense {
  background: rgba(250, 81, 81, 0.1);
  color: var(--color-expense);
}

.type-income {
  background: rgba(76, 175, 80, 0.1);
  color: var(--color-income);
}

.draft-category {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.draft-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 16rpx;
}

.field-label {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  width: 72rpx;
  flex-shrink: 0;
}

.amount-input-wrap {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex: 1;
  background: var(--color-bg-page);
  border-radius: 12rpx;
  padding: 0 20rpx;
  height: 72rpx;
}

.amount-prefix {
  font-size: 28rpx;
  color: var(--color-text-primary);
  margin-right: 8rpx;
}

.amount-input {
  flex: 1;
  font-size: 30rpx;
  color: var(--color-text-primary);
  font-weight: 600;
  height: 72rpx;
}

.note-input {
  flex: 1;
  font-size: 26rpx;
  color: var(--color-text-primary);
  background: var(--color-bg-page);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  height: 72rpx;
}

.ph {
  color: var(--color-text-secondary);
}

.draft-actions {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  margin-top: 8rpx;
}

.btn-ignore {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: var(--radius-btn);
  font-size: 28rpx;
  color: var(--color-text-secondary);
  background: var(--color-bg-card);
  border: 1rpx solid var(--color-border);
}

.btn-confirm {
  flex: 2;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: var(--radius-btn);
  font-size: 28rpx;
  color: #fff;
  background: var(--color-primary);
}

.confirm-all-btn {
  margin: 32rpx 24rpx 0;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: var(--radius-btn);
  font-size: 30rpx;
  color: #fff;
  background: var(--color-primary);
  font-weight: 600;
}
