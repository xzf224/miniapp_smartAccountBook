.page-root {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--color-bg-page);
}

.page-container {
  flex: 1;
  height: 0;
  display: flex;
  flex-direction: column;
  background: var(--color-bg-page);
}

.results-area {
  flex: 1;
  height: 0;
  padding: 24rpx;
  box-sizing: border-box;
}

.scan-stage {
  margin-bottom: 24rpx;
}

.scan-frame {
  position: relative;
  height: 400rpx;
  border-radius: var(--radius-card);
  background: #1a1a1a;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.scan-corner {
  position: absolute;
  width: 40rpx;
  height: 40rpx;
  border-color: var(--color-primary);
  border-style: solid;
}

.corner-left-top {
  top: 20rpx;
  left: 20rpx;
  border-width: 4rpx 0 0 4rpx;
}

.corner-right-top {
  top: 20rpx;
  right: 20rpx;
  border-width: 4rpx 4rpx 0 0;
}

.corner-left-bottom {
  bottom: 20rpx;
  left: 20rpx;
  border-width: 0 0 4rpx 4rpx;
}

.corner-right-bottom {
  right: 20rpx;
  bottom: 20rpx;
  border-width: 0 4rpx 4rpx 0;
}

.scan-line {
  position: absolute;
  top: 50%;
  left: 48rpx;
  right: 48rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, var(--color-primary) 20%, var(--color-primary) 80%, transparent);
}

.scan-camera {
  position: absolute;
  top: 126rpx;
  left: 50%;
  width: 84rpx;
  height: 84rpx;
  transform: translateX(-50%);
  opacity: 0.75;
}

.scan-tip {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 80rpx;
  text-align: center;
  font-size: 24rpx;
  color: #9ea4af;
}

.primary-action {
  margin-top: 24rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: var(--radius-btn);
  background: var(--color-primary);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
}

.secondary-action {
  margin-top: 16rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: var(--radius-btn);
  background: var(--color-bg-card);
  color: var(--color-text-primary);
  font-size: 30rpx;
}

.preview-card,
.draft-item,
.notice-card {
  margin-bottom: 18rpx;
  padding: 24rpx;
  border-radius: var(--radius-card);
  background: var(--color-bg-card);
}

.preview-card {
  overflow: hidden;
  padding: 0;
}

.preview-img {
  width: 100%;
  display: block;
}

.scan-action-btn {
  margin: 24rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: var(--radius-btn);
  background: var(--color-primary);
  color: #fff;
  font-size: 30rpx;
}

.scan-progress {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx 0;
}

.scan-spinner {
  width: 36rpx;
  height: 36rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  border: 4rpx solid var(--color-primary-light);
  border-top-color: var(--color-primary);
  animation: spin 0.8s linear infinite;
}

.scan-progress-text {
  font-size: 26rpx;
  color: #8d95a2;
}

.draft-row {
  display: flex;
  align-items: center;
}

.draft-icon-text {
  width: 68rpx;
  height: 68rpx;
  line-height: 68rpx;
  margin-right: 16rpx;
  border-radius: 34rpx;
  text-align: center;
  font-size: 32rpx;
  background: var(--color-primary-light);
  color: var(--color-primary);
}

.draft-content {
  flex: 1;
  min-width: 0;
}

.draft-pickers {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-bottom: 8rpx;
}

.picker-tag {
  margin-right: 8rpx;
  margin-bottom: 6rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.type-tag {
  background: var(--color-primary-light);
  color: var(--color-primary);
}

.cat-tag {
  background: #f5f6f8;
  color: #5f6773;
}

.draft-note-input {
  font-size: 24rpx;
  color: #4f5866;
}

.draft-date-row {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.draft-date-label {
  font-size: 20rpx;
  color: #9aa3af;
}

.draft-date-value {
  font-size: 22rpx;
  color: #5f6773;
}

.draft-amount-area {
  display: flex;
  align-items: baseline;
  margin-left: 12rpx;
}

.draft-currency {
  font-size: 24rpx;
  color: var(--color-text-primary);
}

.draft-amount-input {
  width: 140rpx;
  text-align: right;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.remove-icon {
  margin-left: 18rpx;
  font-size: 36rpx;
  color: #c0c6d0;
}

.input-ph {
  color: #c0c6d0;
}

.save-all-btn {
  margin-top: 8rpx;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  border-radius: var(--radius-btn);
  background: var(--color-primary);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
}

.recent-section {
  margin-bottom: 20rpx;
}

.recent-head {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 0 0 12rpx;
  margin: 8rpx 0 16rpx;
}

.recent-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.recent-card {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
  padding: 22rpx 24rpx;
  border-radius: var(--radius-card);
  background: var(--color-bg-card);
}

.recent-icon {
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  border-radius: 18rpx;
  text-align: center;
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-size: 26rpx;
}

.recent-meta {
  flex: 1;
  margin-left: 18rpx;
}

.recent-name {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-primary);
}

.recent-date {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8d95a2;
}

.recent-arrow {
  color: #c0c6d0;
  font-size: 34rpx;
}

.notice-card {
  background: var(--color-primary-light);
}

.notice-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.notice-text {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #9a7240;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
