page {
  min-height: 100vh;
}

.page-container {
  min-height: 100vh;
  background: #f7f8fa;
}

.results-area {
  padding: 24rpx;
  box-sizing: border-box;
}

.scan-stage {
  margin-bottom: 24rpx;
}

.scan-frame {
  position: relative;
  height: 360rpx;
  border-radius: 28rpx;
  background: #181818;
  overflow: hidden;
}

.scan-corner {
  position: absolute;
  width: 44rpx;
  height: 44rpx;
  border-color: #ff9800;
}

.corner-left-top {
  top: 18rpx;
  left: 18rpx;
  border-left-width: 4rpx;
  border-top-width: 4rpx;
  border-left-style: solid;
  border-top-style: solid;
}

.corner-right-top {
  top: 18rpx;
  right: 18rpx;
  border-right-width: 4rpx;
  border-top-width: 4rpx;
  border-right-style: solid;
  border-top-style: solid;
}

.corner-left-bottom {
  bottom: 18rpx;
  left: 18rpx;
  border-left-width: 4rpx;
  border-bottom-width: 4rpx;
  border-left-style: solid;
  border-bottom-style: solid;
}

.corner-right-bottom {
  right: 18rpx;
  bottom: 18rpx;
  border-right-width: 4rpx;
  border-bottom-width: 4rpx;
  border-right-style: solid;
  border-bottom-style: solid;
}

.scan-line {
  position: absolute;
  top: 50%;
  left: 48rpx;
  right: 48rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, #ff9800 20%, #ff9800 80%, transparent);
}

.scan-camera {
  position: absolute;
  top: 126rpx;
  left: 50%;
  width: 84rpx;
  height: 84rpx;
  transform: translateX(-50%);
  opacity: 0.75;
}

.scan-tip {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 80rpx;
  text-align: center;
  font-size: 24rpx;
  color: #9ea4af;
}

.primary-action {
  margin-top: 24rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ffb545, #ff8a00);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
}

.secondary-action {
  margin-top: 18rpx;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 22rpx;
  background: #fff;
  color: #5f6773;
  font-size: 28rpx;
}

.preview-card,
.draft-item,
.notice-card {
  margin-bottom: 18rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #fff;
}

.preview-card {
  overflow: hidden;
  padding: 0;
}

.preview-img {
  width: 100%;
  display: block;
}

.scan-action-btn {
  margin: 24rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ffb545, #ff8a00);
  color: #fff;
  font-size: 30rpx;
}

.scan-progress {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx 0;
}

.scan-spinner {
  width: 36rpx;
  height: 36rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 138, 0, 0.2);
  border-top-color: #ff8a00;
  animation: spin 0.8s linear infinite;
}

.scan-progress-text {
  font-size: 26rpx;
  color: #8d95a2;
}

.draft-row {
  display: flex;
  align-items: center;
}

.draft-icon-text {
  width: 68rpx;
  height: 68rpx;
  line-height: 68rpx;
  margin-right: 16rpx;
  border-radius: 34rpx;
  text-align: center;
  font-size: 32rpx;
  background: #fff7eb;
  color: #ff8a00;
}

.draft-content {
  flex: 1;
  min-width: 0;
}

.draft-pickers {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-bottom: 8rpx;
}

.picker-tag {
  margin-right: 8rpx;
  margin-bottom: 6rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.type-tag {
  background: #eaf8f0;
  color: #20a464;
}

.cat-tag {
  background: #f5f6f8;
  color: #5f6773;
}

.draft-note-input {
  font-size: 24rpx;
  color: #4f5866;
}

.draft-amount-area {
  display: flex;
  align-items: baseline;
  margin-left: 12rpx;
}

.draft-currency {
  font-size: 24rpx;
  color: #232831;
}

.draft-amount-input {
  width: 140rpx;
  text-align: right;
  font-size: 34rpx;
  font-weight: 700;
  color: #232831;
}

.remove-icon {
  margin-left: 18rpx;
  font-size: 36rpx;
  color: #c0c6d0;
}

.input-ph {
  color: #c0c6d0;
}

.save-all-btn {
  margin-top: 8rpx;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ffb545, #ff8a00);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
}

.recent-section {
  margin-bottom: 20rpx;
}

.recent-head {
  margin: 8rpx 0 16rpx;
}

.recent-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #232831;
}

.recent-card {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
  padding: 22rpx 24rpx;
  border-radius: 22rpx;
  background: #fff;
}

.recent-icon {
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  border-radius: 18rpx;
  text-align: center;
  background: #f2f4f7;
  color: #8d95a2;
  font-size: 26rpx;
}

.recent-meta {
  flex: 1;
  margin-left: 18rpx;
}

.recent-name {
  display: block;
  font-size: 26rpx;
  color: #232831;
}

.recent-date {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8d95a2;
}

.recent-arrow {
  color: #c0c6d0;
  font-size: 34rpx;
}

.notice-card {
  background: #fff7eb;
}

.notice-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #ff8a00;
}

.notice-text {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #9a7240;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
