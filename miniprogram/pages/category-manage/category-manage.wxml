<view class="page-root">
  <block wx:if="{{!showAddForm}}">
    <navigation-bar title="分类管理" back="{{true}}" background="#F6F7F9" />
    <view class="page-body">
      <view class="type-switch">
        <view
          class="type-pill {{typeIndex === index ? 'active' : ''}}"
          wx:for="{{types}}"
          wx:key="*this"
          data-index="{{index}}"
          bind:tap="onTypeChange"
        >
          {{item}}
        </view>
      </view>

      <scroll-view scroll-y class="category-scroll">
        <view class="category-grid">
          <view
            class="category-item"
            wx:for="{{categories}}"
            wx:key="name"
            data-name="{{item.name}}"
            bindlongpress="onCategoryLongPress"
          >
            <view class="category-icon-wrap" style="background: {{item.bgColor}};">
              <text class="category-icon" style="color: {{item.color}};">{{item.icon}}</text>
            </view>
            <text class="category-name">{{item.displayName}}</text>
          </view>
        </view>
        <view class="category-tip" wx:if="{{categories.length > 0}}">
          长按自定义分类可删除
        </view>
        <view class="scroll-spacer"></view>
      </scroll-view>

      <view class="action-bar">
        <view class="add-trigger" bind:tap="onAddCategory">
          <text class="add-trigger-text">+ 添加自定义分类</text>
        </view>
      </view>
    </view>
  </block>

  <block wx:else>
    <navigation-bar title="添加分类" back="{{false}}" background="#F6F7F9">
      <view slot="left" class="nav-back" bindtap="onCloseAddForm">‹</view>
      <view slot="right" class="nav-save" bindtap="onSaveCategory">保存</view>
    </navigation-bar>

    <scroll-view scroll-y class="page-scroll">
      <view class="form-content">
        <view class="type-switch">
          <view
            class="type-pill {{typeIndex === index ? 'active' : ''}}"
            wx:for="{{types}}"
            wx:key="*this"
            data-index="{{index}}"
            bindtap="onTypeChange"
          >
            {{item}}
          </view>
        </view>

        <view class="form-section">
          <text class="form-section-title">选择图标</text>
          <view class="icon-grid">
            <view
              class="icon-item {{selectedIcon === item ? 'selected' : ''}}"
              wx:for="{{iconOptions}}"
              wx:key="*this"
              data-icon="{{item}}"
              bindtap="onSelectIcon"
            >
              <text class="icon-item-text">{{item}}</text>
            </view>
          </view>
        </view>

        <view class="form-section">
          <text class="form-section-title">选择颜色</text>
          <view class="color-row">
            <view
              class="color-item {{selectedColor === item ? 'selected' : ''}}"
              wx:for="{{colorOptions}}"
              wx:key="*this"
              data-color="{{item}}"
              bindtap="onSelectColor"
              style="background: {{item}};"
            >
              <text wx:if="{{selectedColor === item}}" class="color-check">✓</text>
            </view>
          </view>
        </view>

        <view class="form-section">
          <text class="form-section-title">分类名称</text>
          <input
            class="form-input"
            placeholder="宠物"
            value="{{newName}}"
            maxlength="6"
            bindinput="onNameInput"
          />
        </view>

        <view class="form-section">
          <text class="form-section-title">预算限额（可选）</text>
          <view class="money-input">
            <text class="money-symbol">¥</text>
            <input
              class="money-field"
              type="digit"
              placeholder="设置每月预算"
              value="{{budgetYuan}}"
              bindinput="onBudgetInput"
            />
          </view>
        </view>

        <view class="save-button" bindtap="onSaveCategory">保存分类</view>
      </view>
    </scroll-view>
  </block>
</view>
