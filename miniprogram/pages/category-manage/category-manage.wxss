.page-root {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--color-bg-page);
}

.page-body {
  flex: 1;
  height: 0;
  background: var(--color-bg-page);
}

.hero-card {
  margin: 24rpx 24rpx 0;
  padding: 18rpx;
  border-radius: var(--radius-card);
  background: linear-gradient(135deg, rgba(255, 149, 0, 0.12), rgba(255, 125, 0, 0.05));
  border: 1rpx solid rgba(255, 125, 0, 0.14);
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  box-sizing: border-box;
}

.hero-card-compact {
  padding-bottom: 40rpx;
}

.hero-copy {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.hero-badge {
  flex-shrink: 0;
  min-height: 40rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 125, 0, 0.12);
  color: var(--color-primary);
  font-size: 20rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
}

.hero-title {
  font-size: 27rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.hero-desc {
  font-size: 20rpx;
  line-height: 1.35;
  color: #7a5f3a;
}

.hero-preview-row {
  display: flex;
  flex-direction: row;
  gap: 8rpx;
}

.hero-preview-pill {
  flex: 1;
  min-width: 0;
  padding: 10rpx 14rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.74);
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  box-sizing: border-box;
}

.hero-preview-kicker {
  font-size: 19rpx;
  color: var(--color-text-secondary);
  letter-spacing: 1rpx;
}

.hero-preview-value {
  font-size: 23rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.35;
}

.hero-preview-card {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 14rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.74);
  box-sizing: border-box;
}

.hero-preview-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.hero-preview-icon-text {
  font-size: 32rpx;
  font-weight: 700;
}

.hero-preview-copy {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.hero-preview-name {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  line-height: 1.35;
  word-break: break-all;
}

.hero-preview-meta {
  font-size: 21rpx;
  color: var(--color-text-secondary);
  line-height: 1.35;
}

.section-title {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
  margin: 14rpx 24rpx 8rpx;
  letter-spacing: 1rpx;
}

.section-title-first {
  margin-top: 10rpx;
}

.group-card {
  margin: 0 24rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-card);
  overflow: hidden;
}

.field-block {
  padding: 15rpx 24rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  box-sizing: border-box;
}

.field-block-stack {
  gap: 12rpx;
}

.field-label {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
  letter-spacing: 1rpx;
}

.field-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.field-meta {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  line-height: 1.35;
  text-align: right;
}

.field-input {
  width: 100%;
  min-height: 48rpx;
  font-size: 30rpx;
  color: var(--color-text-primary);
}

.field-placeholder {
  color: #c4c7ce;
}

.input-shell {
  min-height: 96rpx;
  padding: 0 24rpx;
  border-radius: 20rpx;
  background: #fafbfc;
  border: 2rpx solid var(--color-border);
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.field-help {
  display: block;
  font-size: 19rpx;
  line-height: 1.35;
  color: var(--color-text-secondary);
  padding-bottom: 8rpx;
  word-break: break-word;
}

.segmented-control {
  display: flex;
  gap: 12rpx;
}

.segmented-item {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  border-radius: 20rpx;
  background: #f4f5f7;
  color: var(--color-text-secondary);
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.segmented-item-active {
  background: rgba(255, 125, 0, 0.1);
  color: var(--color-primary);
}

.divider {
  margin-left: 24rpx;
  height: 1rpx;
  background: var(--color-border);
}

.divider-full {
  margin-left: 0;
}

.category-grid-wrap {
  padding: 18rpx 14rpx 0;
  box-sizing: border-box;
}

.category-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.category-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 36rpx;
}

.category-icon-wrap {
  width: 104rpx;
  height: 104rpx;
  border-radius: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.category-icon {
  font-size: 42rpx;
  font-weight: 700;
}

.category-name {
  margin-top: 14rpx;
  max-width: 112rpx;
  text-align: center;
  font-size: 22rpx;
  line-height: 1.3;
  color: var(--color-text-primary);
  word-break: break-all;
}

.group-foot {
  padding: 12rpx 24rpx 16rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  text-align: center;
}

.nav-back {
  width: 44rpx;
  height: 44rpx;
  font-size: 46rpx;
  line-height: 40rpx;
  color: var(--color-text-primary);
}

.icon-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -6rpx;
}

.icon-item {
  width: 20%;
  padding: 6rpx;
  box-sizing: border-box;
}

.icon-item-text {
  height: 76rpx;
  border-radius: 24rpx;
  background: #f7f8fa;
  border: 2rpx solid var(--color-border);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: var(--color-text-secondary);
  transition: all 0.2s ease;
}

.icon-item.selected .icon-item-text {
  background: var(--color-primary);
  border-color: var(--color-primary);
  color: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(255, 125, 0, 0.16);
}

.color-row {
  display: flex;
  justify-content: flex-start;
  flex-wrap: wrap;
  gap: 12rpx;
}

.color-item {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.color-item.selected {
  box-shadow: 0 0 0 4rpx #fff, 0 0 0 6rpx rgba(255, 125, 0, 0.24);
}

.color-check {
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
}

.money-input {
  height: 96rpx;
  padding: 0 24rpx;
  border-radius: 20rpx;
  background: #fafbfc;
  border: 2rpx solid var(--color-border);
  box-sizing: border-box;
}

.money-input {
  display: flex;
  align-items: center;
}

.money-symbol {
  margin-right: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.money-field {
  flex: 1;
  height: 100%;
  font-size: 28rpx;
  color: var(--color-text-primary);
}

.bottom-bar {
  padding: 12rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(245, 245, 245, 0) 0%, rgba(245, 245, 245, 0.95) 24%, rgba(245, 245, 245, 1) 100%);
}

.save-btn {
  background: var(--color-primary);
  color: #fff;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 29rpx;
  font-weight: 700;
  text-align: center;
  border-radius: 999rpx;
  letter-spacing: 1rpx;
  box-shadow: 0 8rpx 22rpx rgba(255, 125, 0, 0.18);
}

.page-gap {
  height: 132rpx;
}

.save-btn,
.nav-back {
  display: flex;
  align-items: center;
  justify-content: center;
}
