.page-root {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.page-body {
  flex: 1;
  height: 0;
  background: #f6f7f9;
}

.type-tabs {
  margin: 20rpx 24rpx 0;
  padding: 6rpx;
  background: #ece9e6;
  border-radius: 20rpx;
}

.type-tab {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 28rpx;
  color: #8b8f97;
  border-radius: 16rpx;
}

.type-tab.active {
  background: #fff;
  color: #2f3338;
  font-weight: 600;
}

.grid-card {
  margin: 24rpx;
  padding: 24rpx 12rpx 16rpx;
  background: #fff;
  border-radius: 24rpx;
}

.category-grid {
  display: flex;
  flex-wrap: wrap;
}

.category-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 28rpx;
}

.category-icon-wrap {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.category-icon {
  font-size: 40rpx;
  font-weight: 700;
}

.category-name {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #3e434b;
}

.delete-badge {
  position: absolute;
  top: -8rpx;
  right: -6rpx;
  width: 34rpx;
  height: 34rpx;
  line-height: 34rpx;
  border-radius: 17rpx;
  text-align: center;
  background: #fff;
  color: #ff7d45;
  box-shadow: 0 4rpx 12rpx rgba(255, 138, 0, 0.14);
}

.add-trigger {
  margin: 0 24rpx;
  height: 86rpx;
  line-height: 86rpx;
  text-align: center;
  border-radius: 20rpx;
  background: #fff;
  color: #757d88;
  font-size: 28rpx;
}

.add-panel {
  margin: 20rpx 24rpx 0;
  padding: 28rpx;
  border-radius: 24rpx;
  background: #fff;
}

/* 预览 */
.add-preview {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 20rpx;
  background: #f8f4ff;
  border-radius: 20rpx;
  margin-bottom: 28rpx;
}

.preview-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
}

.preview-icon {
  font-size: 36rpx;
}

.preview-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #3e434b;
}

.add-section-title {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: #888;
  margin-bottom: 16rpx;
}

/* 图标选择网格 */
.icon-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 28rpx;
}

.icon-option {
  width: 68rpx;
  height: 68rpx;
  border-radius: 16rpx;
  background: #f6f7f9;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
}

.icon-option.icon-selected {
  background: #fff3e0;
  border: 2rpx solid #ff8a00;
}

/* 颜色选择网格 */
.color-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.color-dot {
  width: 52rpx;
  height: 52rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.color-dot.color-selected {
  box-shadow: 0 0 0 3rpx #fff, 0 0 0 5rpx currentColor;
}

.color-check {
  font-size: 26rpx;
  color: #fff;
  font-weight: 700;
}

.add-row {
  margin-top: 4rpx;
}

.add-input {
  height: 84rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #2f3338;
  background: #f5f6f8;
  border-radius: 18rpx;
}

.add-btn {
  margin-left: 16rpx;
  width: 132rpx;
  height: 84rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #ffb545, #ff8a00);
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-btn-text {
  font-size: 28rpx;
  color: #fff;
  font-weight: 600;
}
