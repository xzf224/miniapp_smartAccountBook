.page-root {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--color-bg-page);
}

.page-body {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  background: var(--color-bg-page);
}

.type-tabs {
  margin: 18rpx 24rpx 0;
  padding: 4rpx;
  border-radius: 24rpx;
  background: var(--color-border);
  display: flex;
}

.type-tab {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  border-radius: 20rpx;
  font-weight: 500;
}

.type-tab.active {
  background: var(--color-bg-card);
  color: var(--color-primary);
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.category-scroll {
  flex: 1;
  min-height: 0;
}

.category-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  padding: 24rpx 14rpx 0;
}

.category-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 36rpx;
}

.category-icon-wrap {
  width: 104rpx;
  height: 104rpx;
  border-radius: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.category-icon {
  font-size: 42rpx;
  font-weight: 700;
}

.category-name {
  margin-top: 14rpx;
  max-width: 112rpx;
  text-align: center;
  font-size: 22rpx;
  line-height: 1.3;
  color: var(--color-text-primary);
  word-break: break-all;
}

.category-tip {
  padding: 4rpx 24rpx 0;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  text-align: center;
}

.scroll-spacer {
  height: 24rpx;
}

.action-bar {
  padding: 0 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--color-bg-page);
}

.add-trigger {
  height: 92rpx;
  border-radius: var(--radius-card);
  border: 2rpx dashed var(--color-primary);
  background: var(--color-bg-card);
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-trigger-text {
  font-size: 28rpx;
  color: var(--color-primary);
  font-weight: 500;
}

.nav-back {
  width: 44rpx;
  height: 44rpx;
  font-size: 46rpx;
  line-height: 40rpx;
  color: var(--color-text-primary);
}

.nav-save {
  padding: 10rpx 0;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.page-scroll {
  flex: 1;
  min-height: 0;
}

.form-content {
  padding: 16rpx 20rpx calc(24rpx + env(safe-area-inset-bottom));
}

.type-tabs-form {
  margin: 0;
  border-radius: 999rpx;
  background: var(--color-border);
}

.type-tab-form.active {
  background: var(--color-primary);
  color: #ffffff;
  box-shadow: 0 8rpx 16rpx rgba(255, 125, 0, 0.18);
}

.form-section {
  margin-top: 24rpx;
}

.form-section-title {
  display: block;
  margin-bottom: 16rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.icon-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -6rpx;
}

.icon-item {
  width: 20%;
  padding: 6rpx;
  box-sizing: border-box;
}

.icon-item-text {
  height: 72rpx;
  border-radius: 36rpx;
  background: var(--color-bg-card);
  border: 2rpx solid var(--color-border);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: var(--color-text-secondary);
}

.icon-item.selected .icon-item-text {
  background: var(--color-primary);
  border-color: var(--color-primary);
  color: #ffffff;
}

.color-row {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
}

.color-item {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.color-item.selected {
  box-shadow: 0 0 0 4rpx #fff, 0 0 0 6rpx rgba(255, 125, 0, 0.24);
}

.color-check {
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
}

.form-input,
.money-input {
  height: 96rpx;
  padding: 0 24rpx;
  border-radius: var(--radius-card);
  background: var(--color-bg-card);
  border: 2rpx solid var(--color-border);
  box-sizing: border-box;
}

.form-input {
  font-size: 28rpx;
  color: var(--color-text-primary);
}

.money-input {
  display: flex;
  align-items: center;
}

.money-symbol {
  margin-right: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.money-field {
  flex: 1;
  height: 100%;
  font-size: 28rpx;
  color: var(--color-text-primary);
}

.save-button {
  height: 96rpx;
  margin-top: 28rpx;
  border-radius: var(--radius-card);
  background: linear-gradient(135deg, #ffad32 0%, var(--color-primary) 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 32rpx rgba(255, 125, 0, 0.18);
}
