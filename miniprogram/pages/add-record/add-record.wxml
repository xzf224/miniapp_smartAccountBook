<view class="page-body">
  <navigation-bar title="" back="{{true}}" background="#ffffff">
    <view slot="center" class="nav-title">{{isEdit ? '编辑记录' : '新增记录'}}</view>
  </navigation-bar>

  <scroll-view scroll-y class="page-scroll">
    <view class="page-content">
      <view class="type-switch">
        <view
          class="type-pill {{typeIndex === index ? 'active' : ''}}"
          wx:for="{{types}}"
          wx:key="*this"
          data-index="{{index}}"
          bindtap="onTypeChange"
        >
          {{item}}
        </view>
      </view>

      <view class="amount-panel">
        <view class="amount-header">
          <text class="amount-label">金额</text>
          <view class="currency-trigger">
            <text class="currency-trigger-caption">记录币种</text>
            <view class="currency-trigger-main">
              <text class="currency-trigger-symbol">{{currencySymbol}}</text>
              <text class="currency-trigger-code">{{currencyCode}}</text>
            </view>
          </view>
        </view>
        <view class="amount-display">
          <text class="amount-prefix">{{currencySymbol}}</text>
          <input
            class="amount-input"
            type="digit"
            value="{{amountText}}"
            placeholder="0.00"
            placeholder-class="amount-input-ph"
            maxlength="12"
            cursor-spacing="24"
            bindinput="onAmountInput"
            bindfocus="onAmountFocus"
            bindblur="onAmountBlur"
          />
        </view>
        <view class="amount-line"></view>
        <text class="amount-hint">编辑页沿用这条记录当前币种，不在这里修改全局默认货币</text>
      </view>

      <view class="section-title">选择分类</view>
      <view class="category-grid" style="height: {{gridHeight}}rpx; overflow: hidden;">
        <view class="category-grid-inner">
          <view
            class="category-item {{item.name === selectedCategory ? 'active' : ''}}"
            wx:for="{{quickCategories}}"
            wx:key="name"
            data-name="{{item.name}}"
            bindtap="onCategorySelect"
          >
            <view class="category-badge" style="background: {{item.bgColor}};">
              <text class="category-icon" style="color: {{item.color}};">{{item.icon}}</text>
            </view>
            <text class="category-name">{{item.displayName}}</text>
          </view>
        </view>
      </view>
      <view class="category-toggle" wx:if="{{hasMoreCategories}}" bindtap="onToggleCategoryGrid">
        <text class="category-toggle-text">{{categoryGridExpanded ? '收起分类' : '展开更多分类'}}</text>
        <view class="category-toggle-arrow {{categoryGridExpanded ? 'category-toggle-arrow-up' : ''}}"></view>
      </view>

      <view class="meta-list">
        <picker mode="date" value="{{date}}" bindchange="onDateChange">
          <view class="meta-row">
            <view class="meta-leading">
              <view class="meta-icon meta-icon-date">
                <view class="meta-date-body"></view>
                <view class="meta-date-tab meta-date-tab-left"></view>
                <view class="meta-date-tab meta-date-tab-right"></view>
                <view class="meta-date-line"></view>
              </view>
              <text class="meta-label">日期</text>
            </view>
            <view class="meta-value-wrap">
              <text class="meta-value">{{date}}</text>
              <view class="meta-arrow"></view>
            </view>
          </view>
        </picker>

        <view class="meta-row">
          <view class="meta-leading">
            <view class="meta-icon meta-icon-note">
              <view class="meta-note-body"></view>
              <view class="meta-note-line meta-note-line-top"></view>
              <view class="meta-note-line meta-note-line-bottom"></view>
            </view>
            <text class="meta-label">备注</text>
          </view>
          <input
            class="meta-input"
            value="{{note}}"
            placeholder="添加备注"
            placeholder-class="meta-input-placeholder"
            bindinput="onNoteInput"
          />
        </view>
      </view>

      <view class="page-content-bottom-space"></view>
    </view>
  </scroll-view>

  <view class="save-bar">
    <view class="save-button {{canSave ? '' : 'save-button-disabled'}}" bindtap="onSave">
      {{isEdit ? '保存修改' : '保存记录'}}
    </view>
  </view>
</view>
