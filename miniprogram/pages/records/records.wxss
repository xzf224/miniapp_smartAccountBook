.page-body {
  background: var(--color-bg-page);
  min-height: 100vh;
  padding: 0 24rpx 32rpx;
  box-sizing: border-box;
}

.nav-title-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  line-height: 1.1;
}

.nav-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.nav-subtitle {
  margin-top: 4rpx;
  font-size: 18rpx;
  color: var(--color-text-secondary);
  font-weight: 500;
}

.hero-card {
  margin-top: 8rpx;
  padding: 28rpx;
  border-radius: 32rpx;
  background:
    radial-gradient(circle at top right, rgba(255, 255, 255, 0.68) 0, rgba(255, 255, 255, 0) 32%),
    linear-gradient(145deg, #2f241e 0%, #5a4739 58%, #8a6c4d 100%);
  box-shadow: 0 20rpx 50rpx rgba(84, 62, 42, 0.16);
  overflow: hidden;
}

.hero-copy {
  display: flex;
  flex-direction: column;
}

.hero-eyebrow {
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: rgba(255, 245, 233, 0.72);
}

.hero-title {
  margin-top: 14rpx;
  font-size: 42rpx;
  line-height: 1.15;
  font-weight: 700;
  color: #fff8ef;
}

.hero-subtitle {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: rgba(255, 245, 233, 0.76);
}

.summary-grid {
  display: flex;
  gap: 12rpx;
  margin-top: 28rpx;
}

.summary-stat {
  flex: 1;
  min-width: 0;
  padding: 20rpx 18rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(12rpx);
}

.summary-stat-expense {
  background: rgba(255, 232, 224, 0.12);
}

.summary-stat-income {
  background: rgba(228, 255, 237, 0.12);
}

.summary-stat-net {
  background: rgba(255, 255, 255, 0.16);
}

.summary-label {
  display: block;
  font-size: 20rpx;
  color: rgba(255, 245, 233, 0.74);
}

.summary-value {
  display: block;
  margin-top: 10rpx;
  font-size: 28rpx;
  line-height: 1.2;
  font-weight: 700;
  color: #fffefb;
  word-break: break-all;
}

.search-box {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 26rpx;
}

.search-main {
  flex: 1;
  display: flex;
  align-items: center;
  min-width: 0;
  padding: 0 20rpx;
  height: 84rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.92);
}

.search-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 12rpx;
  opacity: 0.65;
  flex: none;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 100%;
  font-size: 24rpx;
  color: var(--color-text-primary);
}

.search-placeholder {
  color: var(--color-text-secondary);
}

.filter-btn {
  position: relative;
  flex: none;
  min-width: 124rpx;
  height: 84rpx;
  padding: 0 22rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.14);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.filter-btn-active {
  background: rgba(255, 202, 133, 0.2);
}

.filter-btn-icon,
.filter-btn-text {
  color: #fff8ef;
}

.filter-btn-icon {
  font-size: 24rpx;
}

.filter-btn-text {
  font-size: 22rpx;
  font-weight: 600;
}

.filter-dot {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--color-primary);
  box-shadow: 0 0 0 4rpx rgba(255, 125, 0, 0.2);
}

.quick-filter-scroll {
  width: calc(100% + 8rpx);
  margin-top: 22rpx;
}

.filter-row {
  display: inline-flex;
  gap: 12rpx;
  padding-right: 8rpx;
}

.filter-pill {
  flex: none;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.12);
  color: rgba(255, 245, 233, 0.82);
  font-size: 22rpx;
  font-weight: 500;
}

.filter-pill.active {
  background: #fff7ef;
  color: #6b4a28;
}

.applied-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.applied-tag {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.1);
  font-size: 20rpx;
  color: rgba(255, 245, 233, 0.82);
}

.result-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 8rpx 6rpx;
}

.result-text {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.group-wrapper {
  padding-top: 6rpx;
}

/* 日期分组 */
.group-block {
  margin-top: 18rpx;
  border-radius: var(--radius-card);
  background: var(--color-bg-card);
  box-shadow: 0 16rpx 32rpx rgba(34, 44, 64, 0.06);
  overflow: hidden;
}

.group-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  padding: 24rpx 24rpx 14rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.group-head-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.group-date {
  font-size: 28rpx;
  line-height: 1.2;
  font-weight: 700;
  color: var(--color-text-primary);
}

.group-count {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--color-text-secondary);
}

.group-totals {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.group-total-chip {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 600;
}

.group-total-expense {
  color: var(--color-primary);
  background: #fff1e2;
}

.group-total-income {
  color: var(--color-income);
  background: #eaf9f0;
}

.group-balance {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 24rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: var(--color-bg-page);
}

.group-balance-label {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.group-balance-value {
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: -0.5rpx;
}

.group-list {
  margin-top: 10rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 36rpx 0;
  text-align: center;
}

.empty-icon {
  width: 84rpx;
  height: 84rpx;
  opacity: 0.5;
}

.empty-title {
  margin-top: 24rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.empty-desc {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: var(--color-text-secondary);
}

.page-safe-space {
  height: 48rpx;
}

.text-expense {
  color: var(--color-expense);
}

.text-income {
  color: var(--color-income);
}

.text-neutral {
  color: #fffefb;
}

/* 高级筛选面板 */
.filter-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(17, 24, 39, 0.28);
  z-index: 100;
}

.filter-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--color-bg-card);
  border-radius: 36rpx 36rpx 0 0;
  z-index: 101;
  padding: 0 0 calc(env(safe-area-inset-bottom) + 12rpx);
  transform: translateY(100%);
  transition: transform 0.3s ease;
  max-height: 82vh;
  display: flex;
  flex-direction: column;
  box-shadow: 0 -20rpx 48rpx rgba(21, 28, 38, 0.14);
}

.filter-panel-show {
  transform: translateY(0);
}

.filter-panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 32rpx 18rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.filter-panel-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.filter-reset {
  font-size: 24rpx;
  color: var(--color-primary);
  font-weight: 600;
}

.filter-scroll {
  flex: 1;
  overflow: hidden;
}

.filter-scroll,
.filter-scroll::-webkit-scrollbar {
  width: 100%;
}

.filter-section {
  padding: 28rpx 32rpx 0;
}

.filter-section-title {
  display: block;
  margin-bottom: 18rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.filter-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding-bottom: 28rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.filter-chip {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: var(--color-bg-page);
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.filter-chip.chip-active {
  background: var(--color-primary);
  color: #fff;
  box-shadow: 0 8rpx 18rpx rgba(255, 125, 0, 0.22);
}

.amount-range-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 28rpx;
  padding-bottom: 28rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.amount-range-input {
  flex: 1;
  height: 72rpx;
  background: var(--color-bg-page);
  border-radius: 16rpx;
  padding: 0 18rpx;
  font-size: 26rpx;
  color: var(--color-text-primary);
  box-sizing: border-box;
}

.range-ph {
  color: var(--color-text-secondary);
  font-size: 24rpx;
}

.range-dash {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.range-unit {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  white-space: nowrap;
}

.filter-actions {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 32rpx 0;
  border-top: 1rpx solid var(--color-border);
}

.filter-cancel-btn,
.filter-confirm-btn {
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.filter-cancel-btn {
  flex: 1;
  border: 1rpx solid var(--color-border);
  color: var(--color-text-secondary);
  background: var(--color-bg-card);
}

.filter-confirm-btn {
  flex: 2;
  background: linear-gradient(135deg, var(--color-primary-gradient-start) 0%, var(--color-primary-gradient-end) 100%);
  color: #fff;
  box-shadow: 0 10rpx 22rpx rgba(255, 125, 0, 0.28);
}
