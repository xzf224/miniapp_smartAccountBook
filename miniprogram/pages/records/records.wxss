.page-scroll {
  height: 100vh;
  background: var(--color-bg-page);
  box-sizing: border-box;
  padding-bottom: calc(72rpx + env(safe-area-inset-bottom));
}

.nav-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

/* 日期控件行 */
.month-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx 12rpx;
  background: var(--color-bg-page);
}

.month-selector {
  display: flex;
  align-items: center;
}

.month-header-label {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  letter-spacing: 2rpx;
}

.month-arrow {
  width: 14rpx;
  height: 14rpx;
  border-right: 3rpx solid #353c46;
  border-bottom: 3rpx solid #353c46;
  transform: rotate(45deg) translateY(-3rpx);
  margin-left: 14rpx;
  box-sizing: border-box;
  flex-shrink: 0;
}

.filter-header-btn {
  position: relative;
  min-width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 0 18rpx;
  border-radius: 18rpx;
  background: var(--color-bg-card);
  box-shadow: 0 8rpx 18rpx rgba(15, 23, 42, 0.05);
  box-sizing: border-box;
}

.filter-header-btn-active {
  background: rgba(255, 138, 0, 0.12);
}

.filter-header-icon {
  width: 36rpx;
  height: 36rpx;
  opacity: 0.65;
}

.filter-header-btn-active .filter-header-icon {
  opacity: 1;
}

.filter-header-label {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1;
}

.filter-header-btn-active .filter-header-label {
  color: var(--color-primary);
}

.filter-header-dot {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--color-primary);
}

.records-tools-card {
  margin: 6rpx 24rpx 0;
  padding: 24rpx;
  border-radius: 28rpx;
  background: var(--color-bg-card);
  box-shadow: 0 10rpx 24rpx rgba(15, 23, 42, 0.04);
}

/* 搜索框 */
.search-wrap {
  display: flex;
  align-items: center;
  background: #f7f8fa;
  border-radius: 24rpx;
  padding: 0 20rpx;
  height: 80rpx;
  gap: 12rpx;
  margin: 0;
}

.search-icon {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.55;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 100%;
  font-size: 26rpx;
  color: var(--color-text-primary);
}

.search-ph {
  color: var(--color-text-secondary);
}

.search-clear {
  font-size: 36rpx;
  color: #bbb;
  padding: 0 4rpx;
  line-height: 1;
}

/* 快捷筛选 pills */
.pills-scroll {
  width: 100%;
  margin-top: 16rpx;
  padding-left: 0;
  box-sizing: border-box;
}

.pills-row {
  display: inline-flex;
  gap: 12rpx;
  padding-right: 4rpx;
  padding-bottom: 4rpx;
}

.filter-pill {
  flex-shrink: 0;
  padding: 10rpx 24rpx;
  border-radius: 32rpx;
  background: #f5f6f8;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  font-weight: 500;
  white-space: nowrap;
}

.pill-active {
  background: var(--color-primary);
  color: #fff;
  font-weight: 600;
}

/* 已应用标签 */
.applied-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  padding: 14rpx 0 0;
}

.applied-tag {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  min-height: 44rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 138, 0, 0.1);
  font-size: 20rpx;
  color: var(--color-primary);
  box-sizing: border-box;
}

.applied-tag-text {
  line-height: 1;
  white-space: nowrap;
}

.applied-tag-close {
  font-size: 20rpx;
  line-height: 1;
  opacity: 0.75;
}

/* 记录列表 */
.group-list {
  padding: 20rpx 24rpx 0;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.group-block {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.group-label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 6rpx;
}

.group-date {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.group-day-summary {
  display: inline-flex;
  align-items: center;
  min-height: 40rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 138, 0, 0.08);
  font-size: 22rpx;
  color: #a16207;
}

.group-card {
  background: var(--color-bg-card);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 10rpx 22rpx rgba(15, 23, 42, 0.04);
}

.record-divider {
  height: 1rpx;
  background: #F3F4F6;
  margin: 0 24rpx;
}

.list-foot {
  height: 112rpx;
}

/* 统计摘要条 */
.stats-strip {
  display: flex;
  flex-direction: column;
  background: #faf7f2;
  border-radius: 24rpx;
  margin: 14rpx 24rpx 0;
  padding: 22rpx 20rpx;
  box-shadow: 0 8rpx 18rpx rgba(15, 23, 42, 0.03);
}

.stats-strip-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.stats-strip-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.stats-strip-meta {
  font-size: 20rpx;
  color: var(--color-text-secondary);
}

.stats-grid {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.stats-item {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  flex: 1;
  min-width: 0;
  padding: 18rpx 18rpx 16rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.82);
  gap: 6rpx;
}

.stats-main {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  line-height: 1;
}

.stats-sub {
  font-size: 20rpx;
  color: var(--color-text-secondary);
  line-height: 1;
}

.stats-mixed {
  margin-top: 10rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid var(--color-border);
}

.stats-mixed-text {
  font-size: 20rpx;
  color: var(--color-text-secondary);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 20rpx 24rpx 0;
  padding: 96rpx 36rpx;
  border-radius: 28rpx;
  background: var(--color-bg-card);
  box-shadow: 0 10rpx 24rpx rgba(15, 23, 42, 0.04);
  text-align: center;
}

.empty-icon {
  width: 84rpx;
  height: 84rpx;
  opacity: 0.5;
}

.empty-title {
  margin-top: 24rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.empty-desc {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: var(--color-text-secondary);
}

/* 高级筛选面板 */
.filter-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(17, 24, 39, 0.32);
  z-index: 100;
}

.filter-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 70vh;
  background: var(--color-bg-card);
  border-radius: 36rpx 36rpx 0 0;
  z-index: 101;
  display: flex;
  flex-direction: column;
  box-shadow: 0 -20rpx 48rpx rgba(21, 28, 38, 0.14);
  transform: translateY(100%);
  transition: transform 0.3s ease;
}

.filter-panel-show {
  transform: translateY(0);
}

.filter-handle {
  width: 64rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--color-border);
  margin: 20rpx auto 0;
  flex-shrink: 0;
}

.filter-panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 32rpx 16rpx;
  border-bottom: 1rpx solid var(--color-border);
  flex-shrink: 0;
}

.filter-panel-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.filter-reset {
  font-size: 26rpx;
  color: var(--color-primary);
  font-weight: 500;
}

.filter-scroll {
  flex: 1;
  height: 0;
}

.filter-section {
  padding: 24rpx 32rpx 0;
}

.filter-section-last {
  padding-bottom: 24rpx;
}

.filter-section-title {
  display: block;
  margin-bottom: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.filter-equal-chips {
  display: flex;
  gap: 10rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.filter-equal-chips-last {
  border-bottom: none;
  padding-bottom: 0;
}

.filter-equal-chip {
  flex: 1;
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
  border-radius: 34rpx;
  background: var(--color-bg-page);
  font-size: 24rpx;
  color: var(--color-text-secondary);
  white-space: nowrap;
}

.filter-equal-chip.chip-active {
  background: var(--color-primary);
  color: #fff;
  font-weight: 600;
}

.date-range-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.date-range-btn {
  flex: 1;
  height: 68rpx;
  background: var(--color-bg-page);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.date-range-text {
  font-size: 24rpx;
  color: var(--color-text-primary);
}

.date-range-ph {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.date-range-sep {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  flex-shrink: 0;
}

.amount-range-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.amount-range-input {
  flex: 1;
  height: 68rpx;
  background: var(--color-bg-page);
  border-radius: 16rpx;
  padding: 0 18rpx;
  font-size: 26rpx;
  color: var(--color-text-primary);
  box-sizing: border-box;
}

.range-ph {
  color: var(--color-text-secondary);
  font-size: 24rpx;
}

.range-dash {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  flex-shrink: 0;
}

.range-unit {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  white-space: nowrap;
  flex-shrink: 0;
}

.filter-actions {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--color-border);
  flex-shrink: 0;
}

.filter-cancel-btn,
.filter-confirm-btn {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.filter-cancel-btn {
  flex: 1;
  border: 1rpx solid var(--color-border);
  color: var(--color-text-secondary);
  background: var(--color-bg-card);
}

.filter-confirm-btn {
  flex: 2;
  background: var(--color-primary);
  color: #fff;
  box-shadow: 0 8rpx 20rpx rgba(255, 125, 0, 0.28);
}

.text-expense { color: var(--color-expense); }
.text-income { color: var(--color-income); }
