<navigation-bar title="" back="{{true}}">
  <view slot="center" class="nav-title">交易记录</view>
</navigation-bar>

<scroll-view scroll-y class="page-scroll" bind:tap="onCloseOpenedSwipe">

  <!-- 日期控件 + 筛选按钮 -->
  <view class="month-header">
    <picker mode="multiSelector" value="{{pickerValue}}" range="{{pickerRange}}" bind:change="onMonthPickerChange">
      <view class="month-selector">
        <text class="month-header-label">{{year}}年{{selectedMonth < 10 ? '0' + selectedMonth : selectedMonth}}月</text>
        <view class="month-arrow"></view>
      </view>
    </picker>
    <view class="filter-header-btn {{hasAdvancedFilter ? 'filter-header-btn-active' : ''}}" bind:tap="onOpenFilter">
      <image class="filter-header-icon" src="/images/new/funnel.png" mode="aspectFit" />
      <view class="filter-header-dot" wx:if="{{hasAdvancedFilter}}"></view>
    </view>
  </view>

  <view class="records-tools-card">
    <!-- 搜索框 -->
    <view class="search-wrap">
      <image class="search-icon" src="/images/search.png" mode="aspectFit" />
      <input
        class="search-input"
        value="{{keyword}}"
        placeholder="搜索交易记录..."
        placeholder-class="search-ph"
        bind:input="onSearchInput"
      />
      <text wx:if="{{keyword}}" class="search-clear" bind:tap="onSearchClear">×</text>
    </view>

    <!-- 已应用筛选标签 -->
    <view class="applied-tags" wx:if="{{appliedTags.length}}">
      <view class="applied-tag" wx:for="{{appliedTags}}" wx:key="key" data-key="{{item.key}}" bind:tap="onRemoveTag">
        <text class="applied-tag-text">{{item.label}}</text>
        <text class="applied-tag-close">×</text>
      </view>
    </view>
  </view>

  <!-- 统计摘要条 -->
  <view class="stats-strip" wx:if="{{groups.length > 0}}">
    <view class="stats-strip-head">
      <text class="stats-strip-title">筛选结果</text>
      <text class="stats-strip-meta">覆盖 {{summaryDays}} 天</text>
    </view>
    <view class="stats-grid">
      <view class="stats-item">
        <text class="stats-main">{{summaryCount}}</text>
        <text class="stats-sub">笔记录</text>
      </view>
      <view class="stats-item">
        <text class="stats-main text-expense">{{currencySymbol}}{{summaryExpenseText}}</text>
        <text class="stats-sub">支出</text>
      </view>
      <view class="stats-item">
        <text class="stats-main text-income">{{currencySymbol}}{{summaryIncomeText}}</text>
        <text class="stats-sub">收入</text>
      </view>
    </view>
    <view class="stats-mixed" wx:if="{{mixedCurrencyCount > 0}}">
      <text class="stats-mixed-text">另有 {{mixedCurrencyCount}} 笔其他货币记录未计入</text>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{groups.length === 0}}">
    <image class="empty-icon" src="/images/list.png" mode="aspectFit" />
    <text class="empty-title">没有找到匹配记录</text>
    <text class="empty-desc">试试切换筛选条件，或返回首页记一笔</text>
  </view>

  <!-- 记录列表 -->
  <view class="group-list" wx:else>
    <view class="group-block" wx:for="{{groups}}" wx:key="date">
      <view class="group-label-row">
        <text class="group-date">{{item.dateDisplay}}</text>
        <view class="group-day-summary">{{item.dayExpense > 0 ? '支 ' + currencySymbol + item.dayExpenseText : ''}}{{item.dayExpense > 0 && item.dayIncome > 0 ? ' · ' : ''}}{{item.dayIncome > 0 ? '收 ' + currencySymbol + item.dayIncomeText : ''}}</view>
      </view>
      <view class="group-card">
        <view wx:for="{{item.records}}" wx:key="id" wx:for-item="record" catch:tap="onRecordWrapTap">
          <swipe-cell
            opened="{{openedRecordId === record.id}}"
            bind:open="onSwipeOpen"
            bind:close="onSwipeClose"
            bind:edit="onRecordEdit"
            bind:delete="onRecordDelete"
            data-id="{{record.id}}"
          >
            <record-item record="{{record}}" compact="{{true}}" iconVariant="budget" subText="{{record.dateTimeText}}" />
          </swipe-cell>
          <view class="record-divider" wx:if="{{index < item.records.length - 1}}"></view>
        </view>
      </view>
    </view>
  </view>

  <view class="list-foot"></view>
</scroll-view>

<!-- 高级筛选面板 -->
<view class="filter-overlay" wx:if="{{showFilter}}" bind:tap="onCloseFilter"></view>
<view class="filter-panel {{showFilter ? 'filter-panel-show' : ''}}">
  <view class="filter-handle"></view>
  <view class="filter-panel-header">
    <text class="filter-panel-title">筛选</text>
    <text class="filter-reset" bind:tap="onResetFilter">重置</text>
  </view>

  <scroll-view scroll-y class="filter-scroll">
    <view class="filter-section">
      <text class="filter-section-title">交易类型</text>
      <view class="filter-equal-chips">
        <view class="filter-equal-chip {{filterType === item.key ? 'chip-active' : ''}}"
              wx:for="{{typeOptions}}" wx:key="key"
              data-key="{{item.key}}" data-field="filterType"
              bind:tap="onChipSelect">{{item.label}}</view>
      </view>
    </view>

    <view class="filter-section">
      <text class="filter-section-title">时间范围</text>
      <view class="filter-equal-chips">
        <view class="filter-equal-chip {{filterTime === item.key ? 'chip-active' : ''}}"
              wx:for="{{timeOptions}}" wx:key="key"
              data-key="{{item.key}}" data-field="filterTime"
              bind:tap="onChipSelect">{{item.label}}</view>
      </view>
      <view class="date-range-row">
        <picker mode="date" value="{{filterDateStart}}" bind:change="onFilterDateStartChange">
          <view class="date-range-btn">
            <text class="{{filterDateStart ? 'date-range-text' : 'date-range-ph'}}">{{filterDateStart || '开始日期'}}</text>
          </view>
        </picker>
        <text class="date-range-sep">至</text>
        <picker mode="date" value="{{filterDateEnd}}" bind:change="onFilterDateEndChange">
          <view class="date-range-btn">
            <text class="{{filterDateEnd ? 'date-range-text' : 'date-range-ph'}}">{{filterDateEnd || '结束日期'}}</text>
          </view>
        </picker>
      </view>
    </view>

    <view class="filter-section">
      <text class="filter-section-title">金额范围</text>
      <view class="amount-range-row">
        <input class="amount-range-input" type="digit" value="{{filterAmountMin}}"
               placeholder="最小金额" placeholder-class="range-ph"
               bind:input="onAmountMinInput" />
        <text class="range-dash">—</text>
        <input class="amount-range-input" type="digit" value="{{filterAmountMax}}"
               placeholder="最大金额" placeholder-class="range-ph"
               bind:input="onAmountMaxInput" />
        <text class="range-unit">元</text>
      </view>
    </view>

    <view class="filter-section filter-section-last">
      <text class="filter-section-title">排序方式</text>
      <view class="filter-equal-chips filter-equal-chips-last">
        <view class="filter-equal-chip {{filterSort === item.key ? 'chip-active' : ''}}"
              wx:for="{{sortOptions}}" wx:key="key"
              data-key="{{item.key}}" data-field="filterSort"
              bind:tap="onChipSelect">{{item.label}}</view>
      </view>
    </view>
  </scroll-view>

  <view class="filter-actions">
    <view class="filter-cancel-btn" bind:tap="onCloseFilter">取消</view>
    <view class="filter-confirm-btn" bind:tap="onConfirmFilter">查看 {{filterPreviewCount}} 条记录</view>
  </view>
</view>
