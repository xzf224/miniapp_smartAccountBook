.page-body {
  padding: 0 0 40rpx;
}

.current-card {
  margin: 24rpx 24rpx 8rpx;
  background: linear-gradient(135deg, #FF8A00 0%, #FFB347 100%);
  border-radius: 24rpx;
  padding: 28rpx 28rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 4rpx 20rpx rgba(255, 138, 0, 0.3);
}

.current-left {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
}

.current-symbol {
  font-size: 52rpx;
  font-weight: 700;
  color: #FFFFFF;
  min-width: 60rpx;
  text-align: center;
}

.current-info {
  display: flex;
  flex-direction: column;
}

.current-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 4rpx;
}

.current-code {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
}

.current-badge {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
  background: rgba(255, 255, 255, 0.25);
  border-radius: 20rpx;
  padding: 6rpx 18rpx;
}

.section-title {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text-secondary, #888);
  margin: 28rpx 24rpx 12rpx;
  letter-spacing: 1rpx;
}

.card {
  margin: 0 24rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(26, 25, 24, 0.05);
}

.currency-list {
  padding: 0;
}

.currency-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 28rpx 28rpx;
  border-bottom: 1rpx solid #F0EFEE;
}

.currency-item:last-child {
  border-bottom: none;
}

.currency-symbol-col {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text-primary, #1A1918);
  min-width: 56rpx;
  margin-right: 20rpx;
  text-align: center;
}

.currency-meta {
  display: flex;
  flex-direction: column;
}

.currency-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-primary, #1A1918);
  margin-bottom: 4rpx;
}

.currency-code {
  font-size: 22rpx;
  color: var(--color-text-secondary, #888);
}

.check-icon {
  font-size: 32rpx;
  font-weight: 700;
  color: #FF8A00;
}

.note-tip {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-secondary, #AAA);
  text-align: center;
  margin: 28rpx 48rpx 0;
  line-height: 1.6;
}

.flex-row {
  display: flex;
  flex-direction: row;
}

.flex-1 {
  flex: 1;
}
