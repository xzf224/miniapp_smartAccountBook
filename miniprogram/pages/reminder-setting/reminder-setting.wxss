.page-root {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--color-bg-page);
}

.page-body {
  flex: 1;
  height: 0;
  background: var(--color-bg-page);
}

.hero-card {
  margin: 24rpx 24rpx 0;
  padding: 20rpx 20rpx;
  border-radius: var(--radius-card);
  background: linear-gradient(135deg, rgba(255, 149, 0, 0.1), rgba(255, 125, 0, 0.04));
  border: 1rpx solid rgba(255, 125, 0, 0.14);
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  box-sizing: border-box;
}

.hero-top {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 10rpx;
}

.hero-copy {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.hero-title {
  font-size: 27rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.hero-desc {
  font-size: 20rpx;
  line-height: 1.4;
  color: #7a5f3a;
}

.hero-badge {
  flex-shrink: 0;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 125, 0, 0.08);
  color: var(--color-primary);
  font-size: 19rpx;
  font-weight: 600;
  white-space: nowrap;
}

.hero-preview-grid {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.hero-preview-pill {
  width: 100%;
  min-width: 0;
  min-height: 88rpx;
  border-radius: 20rpx;
  padding: 14rpx 14rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  box-sizing: border-box;
}

.hero-preview-pill-on {
  background: rgba(255, 255, 255, 0.75);
}

.hero-preview-pill-off {
  background: rgba(255, 255, 255, 0.42);
}

.hero-preview-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
}

.hero-preview-kicker {
  font-size: 19rpx;
  letter-spacing: 1rpx;
  color: var(--color-text-secondary);
}

.hero-preview-state {
  flex-shrink: 0;
  min-width: 76rpx;
  height: 34rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-preview-state-on {
  background: rgba(255, 125, 0, 0.1);
}

.hero-preview-state-off {
  background: #f0f1f3;
}

.hero-preview-state-text {
  font-size: 18rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  white-space: nowrap;
}

.hero-preview-meta {
  font-size: 19rpx;
  line-height: 1.4;
  color: #7a6a52;
  word-break: break-word;
}

.section-title {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
  margin: 18rpx 24rpx 8rpx;
  letter-spacing: 1rpx;
}

.group-card {
  margin: 0 24rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-card);
  overflow: hidden;
}

.group-head {
  padding: 18rpx 24rpx 14rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  align-items: stretch;
}

.group-head-top {
  min-width: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.group-head-title {
  font-size: 27rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  min-width: 0;
}

.group-head-desc {
  font-size: 20rpx;
  line-height: 1.35;
  color: var(--color-text-secondary);
}

.group-status {
  flex-shrink: 0;
  min-width: 92rpx;
  height: 40rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.group-status-on {
  background: rgba(255, 125, 0, 0.1);
}

.group-status-off {
  background: #f0f1f3;
}

.group-status-text {
  font-size: 19rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  white-space: nowrap;
}

.setting-row {
  min-height: 92rpx;
  padding: 16rpx 24rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 14rpx;
  box-sizing: border-box;
}

.setting-row-disabled {
  opacity: 0.48;
}

.setting-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.setting-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.setting-desc {
  font-size: 20rpx;
  line-height: 1.35;
  color: var(--color-text-secondary);
}

.setting-value-wrap {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
  flex-shrink: 0;
  min-width: 112rpx;
  margin-left: 12rpx;
}

.setting-value {
  font-size: 25rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  white-space: nowrap;
}

.setting-arrow {
  font-size: 30rpx;
  color: #c7c7cc;
  white-space: nowrap;
}

.divider {
  margin-left: 24rpx;
  height: 1rpx;
  background: var(--color-border);
}

.divider-full {
  margin-left: 0;
}

.reset-card {
  padding: 18rpx 24rpx;
  display: flex;
  flex-direction: row;
  gap: 14rpx;
  align-items: center;
}

.reset-copy {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.reset-btn {
  min-width: 108rpx;
  height: 58rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 125, 0, 0.1);
  color: var(--color-primary);
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  white-space: nowrap;
}

.footer-note {
  margin: 20rpx 36rpx 0;
  text-align: center;
}

.footer-note-text {
  font-size: 20rpx;
  line-height: 1.5;
  color: var(--color-text-secondary);
}

.setting-value-muted {
  color: var(--color-text-secondary);
}

.page-gap {
  height: 60rpx;
}
