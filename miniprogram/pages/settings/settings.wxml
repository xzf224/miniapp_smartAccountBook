<navigation-bar brand="{{true}}" back="{{false}}" />
<scroll-view scroll-y class="page-body tab-scroll">
  <view class="profile-card">
    <view class="profile-avatar-shell">
      <image
        wx:if="{{profileAvatarUrl}}"
        class="profile-avatar"
        src="{{profileAvatarUrl}}"
        mode="aspectFill"
      />
      <view wx:else class="profile-avatar profile-avatar-placeholder">
        <image class="profile-avatar-icon" src="/images/new/user.png" mode="aspectFit" />
      </view>
    </view>
    <view class="profile-copy">
      <text class="profile-greeting">Hi，欢迎回来</text>
      <text class="profile-name">{{profileNickname || '微信用户'}}</text>
      <text class="profile-subtitle">{{profilePersonalized ? '点击右侧图标修改头像和昵称' : '匿名模式，点击右侧图标开启个性化'}}</text>
    </view>
    <view class="profile-edit-chip" bind:tap="onProfileCardTap">
      <image class="profile-edit-icon" src="/images/note.png" mode="aspectFit" />
    </view>
  </view>

  <view class="profile-editor" wx:if="{{profileEditing}}">
    <view class="profile-editor-head">
      <text class="profile-editor-title">个性化资料</text>
      <text class="profile-editor-desc">设置后仅保存在当前设备</text>
    </view>
    <view class="profile-editor-row">
      <text class="profile-editor-label">头像</text>
      <button class="profile-avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
        <image
          wx:if="{{draftAvatarUrl}}"
          class="profile-avatar profile-avatar-small"
          src="{{draftAvatarUrl}}"
          mode="aspectFill"
        />
        <view wx:else class="profile-avatar profile-avatar-small profile-avatar-placeholder">
          <image class="profile-avatar-icon profile-avatar-icon-small" src="/images/new/user.png" mode="aspectFit" />
        </view>
      </button>
    </view>
    <view class="profile-editor-row">
      <text class="profile-editor-label">昵称</text>
      <input
        class="profile-name-input"
        type="nickname"
        value="{{draftNickname}}"
        placeholder="请输入昵称"
        placeholder-class="profile-name-placeholder"
        bind:input="onNicknameInput"
      />
    </view>
    <view class="profile-editor-actions">
      <view class="profile-editor-btn profile-editor-btn-secondary" bind:tap="onProfileCancel">取消</view>
      <view class="profile-editor-btn profile-editor-btn-primary" bind:tap="onProfileSave">保存</view>
    </view>
  </view>
  <view class="section-header overview-header">数据总览</view>
  <view class="stats-row stats-row-primary">
    <view class="stat-item stat-item-primary stat-accent-orange">
      <text class="stat-kicker">本月</text>
      <text class="stat-value">{{statRecords}}</text>
      <view class="stat-meta">
        <text class="stat-label">记账笔数</text>
        <text class="stat-unit">笔</text>
      </view>
    </view>
    <view class="stat-item stat-item-primary stat-accent-green">
      <text class="stat-kicker">连续</text>
      <text class="stat-value">{{statConsecutiveDays}}</text>
      <view class="stat-meta">
        <text class="stat-label">记账天数</text>
        <text class="stat-unit">天</text>
      </view>
    </view>
    <view class="stat-item stat-item-primary stat-accent-purple">
      <text class="stat-kicker">累计</text>
      <text class="stat-value">{{statTotalDays}}</text>
      <view class="stat-meta">
        <text class="stat-label">记账天数</text>
        <text class="stat-unit">天</text>
      </view>
    </view>
    <view class="stat-item stat-item-primary stat-accent-blue">
      <text class="stat-kicker">当前</text>
      <text class="stat-value">{{statPendingDrafts}}</text>
      <view class="stat-meta">
        <text class="stat-label">待确认草稿</text>
        <text class="stat-unit">条</text>
      </view>
    </view>
  </view>

  <view class="stats-row stats-row-secondary">
    <view class="stat-item stat-item-secondary">
      <text class="stat-value stat-value-secondary">{{statCategories}}</text>
      <view class="stat-meta">
        <text class="stat-label">分类总数</text>
        <text class="stat-unit">个</text>
      </view>
    </view>
    <view class="stat-item stat-item-secondary">
      <text class="stat-value stat-value-secondary">{{statBudgets}}</text>
      <view class="stat-meta">
        <text class="stat-label">预算配置</text>
        <text class="stat-unit">项</text>
      </view>
    </view>
    <view class="stat-item stat-item-secondary">
      <text class="stat-value stat-value-secondary">{{statRules}}</text>
      <view class="stat-meta">
        <text class="stat-label">定期规则</text>
        <text class="stat-unit">个</text>
      </view>
    </view>
    <view class="stat-item stat-item-secondary">
      <text class="stat-value stat-value-secondary">{{statTotalRecords}}</text>
      <view class="stat-meta">
        <text class="stat-label">累计记账笔</text>
        <text class="stat-unit">笔</text>
      </view>
    </view>
  </view>

  <view class="section-header">数据管理</view>
  <view class="card settings-group">
    <view class="settings-item flex-row" bind:tap="onBackupData">
      <view class="item-icon-shell item-icon-shell-orange">
        <image class="item-icon-img" src="/images/arrow-left-right.png" mode="aspectFit" />
      </view>
      <text class="item-label flex-1">数据备份</text>
      <view class="item-arrow"></view>
    </view>
    <view class="divider"></view>
    <view class="settings-item flex-row" bind:tap="onRestoreData">
      <view class="item-icon-shell item-icon-shell-red">
        <image class="item-icon-img" src="/images/brush-cleaning.png" mode="aspectFit" />
      </view>
      <text class="item-label flex-1">数据恢复</text>
      <view class="item-arrow"></view>
    </view>
    <view class="divider"></view>
    <view class="settings-item flex-row" bind:tap="onExportData">
      <view class="item-icon-shell item-icon-shell-blue">
        <image class="item-icon-img" src="/images/export.png" mode="aspectFit" />
      </view>
      <text class="item-label flex-1">导出数据</text>
      <view class="item-arrow"></view>
    </view>
  </view>

  <view class="section-header">个性化</view>
  <view class="card settings-group">
    <view class="settings-item flex-row" bind:tap="onCategoryManage">
      <view class="item-icon-shell item-icon-shell-purple">
        <image class="item-icon-img" src="/images/tag.png" mode="aspectFit" />
      </view>
      <text class="item-label flex-1">分类管理</text>
      <view class="item-arrow"></view>
    </view>
    <view class="divider"></view>
    <!--
    <view class="settings-item flex-row" bind:tap="onBudgetSetting">
      <image class="item-icon-img" src="/images/wallet.png" mode="aspectFit" />
      <text class="item-label flex-1">预算管理</text>
      <text class="item-arrow">›</text>
    </view>
    -->
    <view class="divider"></view>
    <view class="settings-item flex-row" bind:tap="onCurrency">
      <view class="item-icon-shell item-icon-shell-green">
        <image class="item-icon-img" src="/images/circle-dollar-sign.png" mode="aspectFit" />
      </view>
      <text class="item-label flex-1">货币设置</text>
      <view class="item-arrow"></view>
    </view>
    <view class="divider"></view>
    <view class="settings-item flex-row" bind:tap="onRecurring">
      <view class="item-icon-shell item-icon-shell-blue">
        <image class="item-icon-img" src="/images/schedule.png" mode="aspectFit" />
      </view>
      <text class="item-label flex-1">定期账单</text>
      <view class="item-arrow"></view>
    </view>
    <view class="divider"></view>
    <view class="settings-item flex-row" bind:tap="onReminder">
      <view class="item-icon-shell item-icon-shell-orange">
        <image class="item-icon-img" src="/images/alarm-clock.png" mode="aspectFit" />
      </view>
      <text class="item-label flex-1">提醒设置</text>
      <view class="item-arrow"></view>
    </view>
  </view>

  <view class="section-header">关于</view>
  <view class="card settings-group">
    <view class="settings-item flex-row" bind:tap="onAbout">
      <view class="item-icon-shell item-icon-shell-slate">
        <image class="item-icon-img" src="/images/info.png" mode="aspectFit" />
      </view>
      <text class="item-label flex-1">关于我们</text>
      <view class="item-arrow"></view>
    </view>
    <view class="divider"></view>
    <view class="settings-item flex-row" bind:tap="onFeedback">
      <view class="item-icon-shell item-icon-shell-purple">
        <image class="item-icon-img" src="/images/message-circle.png" mode="aspectFit" />
      </view>
      <text class="item-label flex-1">意见反馈</text>
      <view class="item-arrow"></view>
    </view>
  </view>

  <!--
  <view class="logout-btn" bind:tap="onClearAll">退出登录</view>
  -->

  <view class="app-info">
    <text class="app-name">极简小帐</text>
    <text class="app-version">{{version}}</text>
  </view>

</scroll-view>
<bottom-nav current="{{4}}" />
