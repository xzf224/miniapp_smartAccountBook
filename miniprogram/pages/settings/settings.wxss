.page-body {
  height: 100vh;
  background: var(--color-bg-page);
  box-sizing: border-box;
}

.profile-card {
  margin: 20rpx 24rpx 8rpx;
  padding: 28rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-card);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.profile-avatar-btn {
  width: 80rpx;
  height: 80rpx;
  padding: 0;
  margin: 0;
  border: none;
  border-radius: 40rpx;
  background: transparent;
  line-height: normal;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.profile-avatar-btn::after {
  border: none;
}

.profile-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  overflow: hidden;
}

.profile-avatar-small {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
}

.profile-avatar-placeholder {
  background: rgba(255, 125, 0, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
}

.profile-avatar-icon {
  width: 44rpx;
  height: 44rpx;
}

.profile-avatar-icon-small {
  width: 36rpx;
  height: 36rpx;
}

.profile-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.profile-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  line-height: 1.2;
}

.profile-edit-icon {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  opacity: 0.72;
}

.profile-editor {
  margin: 0 24rpx 8rpx;
  padding: 24rpx 28rpx 28rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-card);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.profile-editor-head {
  display: flex;
  flex-direction: column;
}

.profile-editor-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.profile-editor-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.profile-editor-row {
  margin-top: 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.profile-editor-label {
  font-size: 26rpx;
  color: var(--color-text-primary);
  flex-shrink: 0;
}

.profile-name-input {
  height: 44rpx;
  flex: 1;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  text-align: right;
}

.profile-name-placeholder {
  color: var(--color-text-placeholder);
}

.profile-subtitle {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.profile-editor-actions {
  margin-top: 28rpx;
  display: flex;
  gap: 16rpx;
}

.profile-editor-btn {
  flex: 1;
  height: 72rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
}

.profile-editor-btn-secondary {
  background: var(--color-bg-page);
  color: var(--color-text-secondary);
}

.profile-editor-btn-primary {
  background: var(--color-primary);
  color: #fff;
}

/* 顶部统计区 */
.stats-row {
  background: var(--color-bg-card);
  display: flex;
  flex-direction: row;
  padding: 36rpx 0 28rpx;
  margin: 16rpx 24rpx 24rpx;
  border-radius: var(--radius-card);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-right: 1rpx solid var(--color-border);
}

.stat-item:last-child {
  border-right: none;
}

.stat-value {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.stat-label {
  font-size: 20rpx;
  color: var(--color-text-secondary);
  margin-top: 6rpx;
  text-align: center;
  padding: 0 6rpx;
}

/* 区块标题 */
.section-header {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  padding: 8rpx 32rpx 12rpx;
  letter-spacing: 1rpx;
}

.overview-header {
  padding-top: 20rpx;
  padding-bottom: 4rpx;
}

/* 菜单组 */
.settings-group {
  background: var(--color-bg-card);
  border-radius: var(--radius-card);
  margin: 0 24rpx 16rpx;
  overflow: hidden;
}

.settings-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 28rpx 32rpx;
  min-height: 100rpx;
  box-sizing: border-box;
}

.item-icon-img {
  width: 40rpx;
  height: 40rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.item-label {
  font-size: 28rpx;
  color: var(--color-text-primary);
}

.item-arrow {
  font-size: 32rpx;
  color: var(--color-text-placeholder);
}

.divider {
  height: 1rpx;
  background: var(--color-border);
  margin: 0 32rpx;
}

/* 退出登录 */
.logout-btn {
  margin: 40rpx 24rpx 24rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: var(--radius-btn);
  background: var(--color-bg-card);
  color: var(--color-expense);
  font-size: 30rpx;
  font-weight: 600;
}

/* app 信息 */
.app-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0 40rpx;
}

.app-name {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.app-version {
  font-size: 22rpx;
  color: var(--color-text-placeholder);
  margin-top: 6rpx;
}

/* flex utility used in wxml */
.flex-row {
  display: flex;
  flex-direction: row;
}

.flex-1 {
  flex: 1;
}
