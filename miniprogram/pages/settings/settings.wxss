.page-body {
  height: 100vh;
  background: var(--color-bg-page);
  box-sizing: border-box;
}

.profile-card {
  margin: 20rpx 24rpx 8rpx;
  padding: 28rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: linear-gradient(135deg, rgba(255, 125, 0, 0.12), rgba(255, 125, 0, 0.04));
  border-radius: var(--radius-card);
  border: 1rpx solid rgba(255, 125, 0, 0.18);
  box-shadow: 0 8rpx 22rpx rgba(255, 149, 0, 0.08);
}

.profile-avatar-shell {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.profile-avatar-btn {
  width: 80rpx;
  height: 80rpx;
  padding: 0;
  margin: 0;
  border: none;
  border-radius: 40rpx;
  background: transparent;
  line-height: normal;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.profile-avatar-btn::after {
  border: none;
}

.profile-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  overflow: hidden;
}

.profile-avatar-small {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
}

.profile-avatar-placeholder {
  background: rgba(255, 125, 0, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
}

.profile-avatar-icon {
  width: 44rpx;
  height: 44rpx;
}

.profile-avatar-icon-small {
  width: 36rpx;
  height: 36rpx;
}

.profile-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.profile-greeting {
  font-size: 20rpx;
  color: rgba(31, 35, 41, 0.62);
  letter-spacing: 1rpx;
}

.profile-name {
  margin-top: 6rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  line-height: 1.2;
}

.profile-edit-chip {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.76);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.profile-edit-icon {
  width: 34rpx;
  height: 34rpx;
  opacity: 0.72;
}

.profile-editor {
  margin: 0 24rpx 8rpx;
  padding: 24rpx 28rpx 28rpx;
  background: var(--color-bg-card);
  border-radius: 22rpx;
  box-shadow: 0 6rpx 18rpx rgba(15, 23, 42, 0.04);
}

.profile-editor-head {
  display: flex;
  flex-direction: column;
}

.profile-editor-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.profile-editor-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.profile-editor-row {
  margin-top: 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.profile-editor-label {
  font-size: 26rpx;
  color: var(--color-text-primary);
  flex-shrink: 0;
}

.profile-name-input {
  height: 44rpx;
  flex: 1;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  text-align: right;
}

.profile-name-placeholder {
  color: var(--color-text-placeholder);
}

.profile-subtitle {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.profile-editor-actions {
  margin-top: 28rpx;
  display: flex;
  gap: 16rpx;
}

.profile-editor-btn {
  flex: 1;
  height: 72rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
}

.profile-editor-btn-secondary {
  background: var(--color-bg-page);
  color: var(--color-text-secondary);
}

.profile-editor-btn-primary {
  background: var(--color-primary);
  color: #fff;
}

/* 顶部统计区 */
.stats-row {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  margin: 0 24rpx 16rpx;
}

.stats-row-secondary {
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.stat-item {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  background: var(--color-bg-card);
  border-radius: 24rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.stats-row-primary .stat-item {
  min-height: 188rpx;
  padding: 24rpx 22rpx 22rpx;
  box-shadow: 0 8rpx 22rpx rgba(15, 23, 42, 0.05);
}

.stats-row-secondary .stat-item {
  width: calc((100% - 12rpx) / 2);
  min-height: 88rpx;
  padding: 14rpx 16rpx 12rpx;
  background: rgba(255, 255, 255, 0.46);
  flex: none;
  box-shadow: none;
}

.stat-item-primary::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 8rpx;
  border-radius: 24rpx 24rpx 0 0;
}

.stat-accent-orange::before {
  background: #FF8A00;
}

.stat-accent-green::before {
  background: #2ECC71;
}

.stat-accent-purple::before {
  background: #7A6FF0;
}

.stat-accent-blue::before {
  background: #4A9EFF;
}

.stat-kicker {
  font-size: 18rpx;
  color: var(--color-text-secondary);
  letter-spacing: 1rpx;
}

.stat-value {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--color-primary);
  line-height: 1;
  margin-top: 16rpx;
}

.stat-value-secondary {
  font-size: 30rpx;
  color: #5c6674;
  margin-top: 2rpx;
}

.stats-row-secondary .stat-meta {
  margin-top: 6rpx;
  gap: 6rpx;
}

.stats-row-secondary .stat-label {
  font-size: 18rpx;
  line-height: 1.2;
}

.stats-row-secondary .stat-unit {
  font-size: 16rpx;
}

.stat-meta {
  margin-top: auto;
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.stat-label {
  font-size: 20rpx;
  color: var(--color-text-secondary);
  line-height: 1.3;
}

.stat-unit {
  font-size: 18rpx;
  color: var(--color-text-placeholder);
  line-height: 1;
}

/* 区块标题 */
.section-header {
  font-size: 24rpx;
  color: var(--color-text-placeholder);
  padding: 4rpx 32rpx 10rpx;
  letter-spacing: 1rpx;
}

.overview-header {
  padding-top: 20rpx;
  padding-bottom: 12rpx;
  color: var(--color-text-secondary);
  font-weight: 600;
}

/* 菜单组 */
.settings-group {
  background: var(--color-bg-card);
  border-radius: 22rpx;
  margin: 0 24rpx 20rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 18rpx rgba(15, 23, 42, 0.04);
}

.settings-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 28rpx 32rpx;
  min-height: 100rpx;
  box-sizing: border-box;
}

.item-icon-shell {
  width: 64rpx;
  height: 64rpx;
  margin-right: 20rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.item-icon-shell-orange {
  background: rgba(255, 138, 0, 0.14);
}

.item-icon-shell-red {
  background: rgba(239, 68, 68, 0.12);
}

.item-icon-shell-blue {
  background: rgba(74, 158, 255, 0.12);
}

.item-icon-shell-purple {
  background: rgba(122, 111, 240, 0.12);
}

.item-icon-shell-green {
  background: rgba(46, 204, 113, 0.12);
}

.item-icon-shell-slate {
  background: rgba(100, 116, 139, 0.12);
}

.item-icon-img {
  width: 34rpx;
  height: 34rpx;
  opacity: 0.88;
}

.item-label {
  font-size: 28rpx;
  color: var(--color-text-primary);
}

.item-arrow {
  width: 16rpx;
  height: 16rpx;
  border-top: 2rpx solid #b8c0cc;
  border-right: 2rpx solid #b8c0cc;
  transform: rotate(45deg);
  flex-shrink: 0;
}

.divider {
  height: 1rpx;
  background: var(--color-border);
  margin: 0 32rpx;
}

/* 退出登录 */
.logout-btn {
  margin: 40rpx 24rpx 24rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: var(--radius-btn);
  background: var(--color-bg-card);
  color: var(--color-expense);
  font-size: 30rpx;
  font-weight: 600;
}

/* app 信息 */
.app-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0 40rpx;
}

.app-name {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.app-version {
  font-size: 22rpx;
  color: var(--color-text-placeholder);
  margin-top: 6rpx;
}

/* flex utility used in wxml */
.flex-row {
  display: flex;
  flex-direction: row;
}

.flex-1 {
  flex: 1;
}
