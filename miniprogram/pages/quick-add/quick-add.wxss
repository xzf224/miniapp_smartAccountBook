.page-body {
  min-height: 100vh;
  background: #ffffff;
  display: flex;
  flex-direction: column;
}

.page-content {
  padding: 6rpx 0 0;
}

.nav-side {
  font-size: 28rpx;
  line-height: 1;
  padding: 10rpx 0;
}

.nav-back-btn {
  color: #1f2329;
  font-size: 46rpx;
  font-weight: 300;
  line-height: 1;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2329;
}

/* 支出/收入切换 */
.type-switch {
  display: flex;
  background: #f0f0f0;
  border-radius: 40rpx;
  margin: 24rpx 32rpx;
  padding: 6rpx;
}

.type-pill {
  flex: 1;
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
  border-radius: 36rpx;
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.type-pill.active {
  background: var(--color-primary);
  color: #fff;
  font-weight: 600;
}

.amount-panel {
  padding: 22rpx 32rpx 0;
}

.amount-label {
  display: block;
  text-align: center;
  font-size: 18rpx;
  color: #b5bcc7;
}

.amount-display {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 10rpx;
}

.currency-chip {
  height: 64rpx;
  padding: 0 10rpx;
  margin-right: 12rpx;
  border-radius: 17rpx;
  background: #f3f4f7;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.currency-symbol {
  font-size: 18rpx;
  color: #666f7d;
}

.currency-arrow {
  width: 10rpx;
  height: 10rpx;
  border-right: 2rpx solid #666f7d;
  border-bottom: 2rpx solid #666f7d;
  transform: rotate(45deg) translateY(-1rpx);
  box-sizing: border-box;
}

.amount-value {
  font-size: 72rpx;
  font-weight: 700;
  color: #21252b;
  letter-spacing: -2rpx;
  min-width: 160rpx;
  text-align: left;
}

.amount-input {
  min-width: 190rpx;
  height: 88rpx;
  font-size: 72rpx;
  font-weight: 700;
  color: #21252b;
  line-height: 88rpx;
  letter-spacing: -2rpx;
  padding: 0;
  box-sizing: border-box;
}

.amount-line {
  width: 248rpx;
  height: 4rpx;
  margin: 10rpx auto 0;
  border-radius: 999rpx;
  background: var(--color-primary);
}

.section-title {
  margin: 36rpx 32rpx 0;
  font-size: 22rpx;
  font-weight: 600;
  color: #252a31;
}

.category-grid {
  margin: 0 10rpx;
}

.category-grid-inner {
  display: flex;
  flex-wrap: wrap;
  padding: 18rpx 0 0;
}

.category-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 28rpx;
}

.category-badge {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background: #f3f4f7;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.15s;
}

.category-item.active .category-badge {
  box-shadow: 0 0 0 3rpx var(--color-primary);
  transform: scale(1.12);
}

.category-icon {
  font-size: 28rpx;
  font-weight: 700;
}

.category-name {
  margin-top: 10rpx;
  font-size: 18rpx;
  color: #707785;
  white-space: nowrap;
}

.category-item.active .category-name {
  color: var(--color-primary);
  font-weight: 700;
}

.meta-list {
  margin: 2rpx 32rpx 0;
  border-top: 1rpx solid #f0f2f5;
}

.meta-row {
  height: 86rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #f0f2f5;
}

.meta-leading {
  display: flex;
  align-items: center;
}

.meta-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 14rpx;
  position: relative;
  flex: none;
}

.meta-icon-date .meta-date-body {
  position: absolute;
  left: 3rpx;
  right: 3rpx;
  top: 7rpx;
  bottom: 3rpx;
  border: 2rpx solid #9ca5b3;
  border-radius: 6rpx;
}

.meta-icon-date .meta-date-tab {
  position: absolute;
  top: 3rpx;
  width: 4rpx;
  height: 7rpx;
  border-radius: 2rpx;
  background: #9ca5b3;
}

.meta-icon-date .meta-date-tab-left {
  left: 8rpx;
}

.meta-icon-date .meta-date-tab-right {
  right: 8rpx;
}

.meta-icon-date .meta-date-line {
  position: absolute;
  left: 7rpx;
  right: 7rpx;
  top: 13rpx;
  height: 2rpx;
  background: #9ca5b3;
}

.meta-icon-note .meta-note-body {
  position: absolute;
  left: 5rpx;
  right: 6rpx;
  top: 3rpx;
  bottom: 3rpx;
  border: 2rpx solid #9ca5b3;
  border-radius: 5rpx;
}

.meta-icon-note .meta-note-line {
  position: absolute;
  left: 10rpx;
  right: 10rpx;
  height: 2rpx;
  background: #9ca5b3;
}

.meta-icon-note .meta-note-line-top {
  top: 11rpx;
}

.meta-icon-note .meta-note-line-bottom {
  top: 17rpx;
}

.meta-label {
  font-size: 23rpx;
  color: #5c6674;
}

.meta-value-wrap {
  display: flex;
  align-items: center;
}

.meta-value,
.meta-input {
  font-size: 23rpx;
  color: #99a2b0;
  text-align: right;
}

.meta-input {
  width: 300rpx;
  margin-left: 24rpx;
}

.meta-input-placeholder {
  color: #b3bac5;
}

.meta-arrow {
  width: 12rpx;
  height: 12rpx;
  margin-left: 12rpx;
  border-right: 2rpx solid #c1c8d1;
  border-bottom: 2rpx solid #c1c8d1;
  transform: rotate(-45deg);
  box-sizing: border-box;
}

/* 保存按钮 */
.save-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #fff;
}

.save-button {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: var(--radius-btn);
  background: var(--color-primary);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
}
