<navigation-bar title="语音记账" />
<view class="page-container">
  <scroll-view class="results-area" scroll-y="{{true}}">
    <view wx:if="{{!showResult && !recognizedText && !isTranslating}}" class="hero-state">
      <text class="hero-title">请说出您的消费记录</text>
      <text class="hero-subtitle">点击麦克风或按住开始语音输入</text>
      <view class="wave-bars">
        <view class="wave-bar" wx:for="{{[16,30,44,26,38,18,48,24,34,20,42,14]}}" wx:key="index" style="height: {{item}}rpx;"></view>
      </view>
      <view class="example-list">
        <view class="example-item" wx:for="{{examples}}" wx:key="*this">
          <text class="example-text">“{{item}}”</text>
        </view>
      </view>
    </view>

    <view wx:if="{{isTranslating && !recognizedText}}" class="hero-state">
      <view class="loading-ring"></view>
      <text class="empty-title">正在识别中…</text>
    </view>

    <view wx:if="{{recognizedText}}" class="raw-text-card">
      <text class="raw-text-label">识别原文</text>
      <text class="raw-text">{{recognizedText}}</text>
    </view>

    <block wx:if="{{showResult}}">
      <view class="draft-item" wx:for="{{drafts}}" wx:key="tempId">
        <view class="draft-row1">
          <text class="draft-icon-text">{{item.icon}}</text>
          <picker range="{{allTypes}}" value="{{item.typeIndex}}"
                  bindchange="onEditType" data-index="{{index}}">
            <view class="draft-chip {{item.type === '收入' ? 'chip-income' : item.type === '支出' ? 'chip-expense' : 'chip-neutral'}}">{{item.type}} ▾</view>
          </picker>
          <picker range="{{allCategories[item.type]}}" value="{{item.categoryIndex}}"
                  bindchange="onEditCategory" data-index="{{index}}">
            <view class="draft-chip chip-cat">{{item.category}} ▾</view>
          </picker>
          <view class="remove-icon" bind:tap="onRemoveDraft" data-index="{{index}}">×</view>
        </view>
        <view class="draft-row2">
          <picker mode="date" value="{{item.date}}" bindchange="onEditDate" data-index="{{index}}">
            <view class="draft-date-chip">{{item.date}}</view>
          </picker>
          <input class="draft-note-input" value="{{item.note}}"
                 bind:input="onEditNote" data-index="{{index}}"
                 placeholder="添加备注" placeholder-class="input-ph" />
          <view class="draft-amount-area">
            <text class="draft-currency">¥</text>
            <input class="draft-amount-input" type="digit" value="{{item.amountYuan}}"
                   bind:input="onEditAmount" data-index="{{index}}"
                   placeholder="0.00" placeholder-class="input-ph" />
          </view>
        </view>
      </view>

      <view class="save-all-btn" bind:tap="onSaveAll">
        <text>保存全部（{{drafts.length}} 条）</text>
      </view>
    </block>
  </scroll-view>

  <view class="bottom-panel">
    <text class="status-label">{{isTranslating ? '识别中…' : isRecording ? '松开结束录音' : '点击或按住开始说话'}}</text>

    <view class="mic-btn {{isRecording ? 'mic-recording' : ''}} {{isTranslating ? 'mic-translating' : ''}}"
          bind:touchstart="onStartRecord"
          bind:touchend="onStopRecord"
          bind:touchcancel="onStopRecord"
          catch:touchmove="preventMove">
      <image class="mic-icon-img" src="/images/record.png" mode="aspectFit" />
    </view>

    <text class="disclaimer">本服务为 AI 生成内容，结果仅供参考</text>
  </view>
</view>
