page {
  height: 100vh;
}

.page-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f7f8fa;
}

.results-area {
  flex: 1;
  height: 0;
  padding: 24rpx;
  box-sizing: border-box;
}

.hero-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
}

.hero-title,
.empty-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #232831;
}

.hero-subtitle,
.empty-hint {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #a0a7b4;
}

.wave-bars {
  display: flex;
  align-items: flex-end;
  gap: 8rpx;
  margin-top: 60rpx;
  height: 56rpx;
}

.wave-bar {
  width: 8rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #ffb545, #ff8a00);
}

.example-list {
  width: 100%;
  margin-top: 60rpx;
}

.example-item {
  margin-bottom: 16rpx;
  padding: 24rpx 28rpx;
  border-radius: 20rpx;
  background: #fff7eb;
  text-align: center;
}

.example-text {
  font-size: 28rpx;
  color: #ff8a00;
}

.loading-ring {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  border: 8rpx solid rgba(255, 138, 0, 0.15);
  border-top-color: #ff8a00;
  margin-bottom: 24rpx;
  animation: spin 0.9s linear infinite;
}

.raw-text-card,
.draft-item {
  margin-bottom: 16rpx;
  padding: 24rpx 28rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(33, 38, 45, 0.04);
}

.raw-text-label {
  font-size: 22rpx;
  color: #a0a7b4;
}

.raw-text {
  margin-top: 12rpx;
  font-size: 30rpx;
  line-height: 1.6;
  color: #232831;
}

.draft-row1,
.draft-row2 {
  display: flex;
  align-items: center;
}

.draft-row1 {
  margin-bottom: 16rpx;
}

.draft-icon-text {
  width: 68rpx;
  height: 68rpx;
  line-height: 68rpx;
  margin-right: 16rpx;
  border-radius: 34rpx;
  text-align: center;
  font-size: 32rpx;
  background: #fff7eb;
  color: #ff8a00;
}

.draft-chip {
  margin-right: 10rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.chip-income {
  background: #eaf8f0;
  color: #20a464;
}

.chip-expense {
  background: #fff1ec;
  color: #ff7a45;
}

.chip-neutral {
  background: #f0f2f5;
  color: #77808d;
}

.chip-cat {
  background: #f5f6f8;
  color: #4f5866;
}

.remove-icon {
  margin-left: auto;
  color: #c0c6d0;
  font-size: 36rpx;
  line-height: 1;
}

.draft-date-chip {
  margin-right: 16rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #f5f6f8;
  color: #8d95a2;
  font-size: 22rpx;
}

.draft-note-input {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #4f5866;
}

.draft-amount-area {
  display: flex;
  align-items: baseline;
  margin-left: 12rpx;
}

.draft-currency {
  margin-right: 4rpx;
  font-size: 24rpx;
  color: #232831;
}

.draft-amount-input {
  width: 160rpx;
  text-align: right;
  font-size: 34rpx;
  font-weight: 700;
  color: #232831;
}

.input-ph {
  color: #c0c6d0;
}

.save-all-btn {
  margin-top: 10rpx;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ffb545, #ff8a00);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 10rpx 24rpx rgba(255, 138, 0, 0.28);
}

.bottom-panel {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 24rpx calc(36rpx + env(safe-area-inset-bottom));
}

.status-label {
  font-size: 24rpx;
  color: #8d95a2;
}

.mic-btn {
  width: 156rpx;
  height: 156rpx;
  margin-top: 28rpx;
  border-radius: 78rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #ffb545, #ff8a00);
  box-shadow: 0 0 0 24rpx rgba(255, 138, 0, 0.08), 0 0 0 48rpx rgba(255, 138, 0, 0.04);
}

.mic-recording {
  transform: scale(1.06);
}

.mic-translating {
  opacity: 0.75;
}

.mic-icon-img {
  width: 60rpx;
  height: 60rpx;
}

.disclaimer {
  margin-top: 24rpx;
  font-size: 22rpx;
  color: #c0c6d0;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
