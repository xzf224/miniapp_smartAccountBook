<view class="page-root">
  <navigation-bar title="{{isEdit ? '编辑定期账单' : '新增定期账单'}}" back="{{true}}" />
  <scroll-view scroll-y class="page-body">
    <view class="hero-card">
      <view class="hero-copy">
        <text class="hero-title">{{isEdit ? '调整这条定期规则的执行节奏' : '设置固定收支的发生节奏'}}</text>
        <text class="hero-desc">{{isEdit ? '修改后会从下一次执行开始生效。' : '保存后会按设定周期生成待处理草稿。'}}</text>
      </view>
      <view class="hero-preview-grid">
        <view class="hero-preview-pill">
          <text class="hero-preview-kicker">规则概览</text>
          <text class="hero-preview-value">{{types[typeIndex]}} · {{categoryPreviewText}}</text>
        </view>
        <view class="hero-preview-pill">
          <text class="hero-preview-kicker">金额与频率</text>
          <text class="hero-preview-value">{{amountPreviewText}} · {{scheduleSummaryText}}</text>
        </view>
        <view class="hero-preview-pill">
          <text class="hero-preview-kicker">生效范围</text>
          <text class="hero-preview-value">{{dateRangeSummaryText}}</text>
        </view>
      </view>
    </view>

    <text class="section-title section-title-first">基本信息</text>
    <view class="group-card">
      <view class="field-block">
        <text class="field-label">名称</text>
        <input class="field-input"
               value="{{name}}"
               placeholder="如：房租、会员费、话费"
               placeholder-class="field-placeholder"
               maxlength="20"
               bind:input="onNameInput" />
      </view>

      <view class="divider divider-full"></view>

      <view class="field-block">
        <text class="field-label">类型</text>
        <view class="segmented-control">
          <view class="segmented-item {{typeIndex === index ? 'segmented-item-active' : ''}}"
                wx:for="{{types}}" wx:key="*this"
                data-index="{{index}}"
                bind:tap="onTypeChange">
            {{item}}
          </view>
        </view>
      </view>

      <view class="divider divider-full"></view>

      <view class="field-block field-block-stack">
        <view class="field-head">
          <text class="field-label">类别</text>
          <text class="field-meta">{{categoryPreviewText}}</text>
        </view>
        <category-grid categories="{{categories}}" selected="{{selectedCategory}}" bind:select="onCategorySelect" />
      </view>

      <view class="divider divider-full"></view>

      <view class="field-block">
        <view class="field-head field-head-inline">
          <text class="field-label">金额</text>
          <text class="field-meta field-meta-strong">{{amountPreviewText}}</text>
        </view>
        <view class="amount-input-wrap">
          <text class="amount-prefix">¥</text>
          <input class="amount-input"
                 type="digit"
                 value="{{amountText}}"
                 placeholder="0.00"
                 placeholder-class="field-placeholder"
                 bind:input="onAmountInput" />
        </view>
      </view>

      <view class="divider divider-full"></view>

      <view class="field-block">
        <text class="field-label">备注</text>
        <input class="field-input"
               value="{{note}}"
               placeholder="可选，补充规则说明"
               placeholder-class="field-placeholder"
               bind:input="onNoteInput" />
      </view>
    </view>

    <text class="section-title">执行规则</text>
    <view class="group-card">
      <picker mode="selector" range="{{freqOptions}}" value="{{freqIndex}}" bind:change="onFreqChange">
        <view class="setting-row">
          <view class="setting-copy">
            <text class="setting-title">频率</text>
            <text class="setting-desc">决定这条规则多久执行一次</text>
          </view>
          <view class="setting-value-wrap">
            <text class="setting-value">{{freqOptions[freqIndex]}}</text>
            <text class="setting-arrow">›</text>
          </view>
        </view>
      </picker>

      <view wx:if="{{freqIndex === 1}}">
        <view class="divider"></view>
        <picker mode="selector" range="{{dowOptions}}" value="{{dowIndex}}" bind:change="onDowChange">
          <view class="setting-row">
            <view class="setting-copy">
              <text class="setting-title">执行星期</text>
              <text class="setting-desc">每周固定一天执行</text>
            </view>
            <view class="setting-value-wrap">
              <text class="setting-value">{{dowOptions[dowIndex]}}</text>
              <text class="setting-arrow">›</text>
            </view>
          </view>
        </picker>
      </view>

      <view wx:if="{{freqIndex === 2}}">
        <view class="divider"></view>
        <picker mode="selector" range="{{domOptions}}" value="{{domIndex}}" bind:change="onDomChange">
          <view class="setting-row">
            <view class="setting-copy">
              <text class="setting-title">执行日期</text>
              <text class="setting-desc">每月在这一天执行</text>
            </view>
            <view class="setting-value-wrap">
              <text class="setting-value">{{domOptions[domIndex]}}</text>
              <text class="setting-arrow">›</text>
            </view>
          </view>
        </picker>
      </view>

      <view wx:if="{{freqIndex === 3}}">
        <view class="divider"></view>
        <picker mode="selector" range="{{moyOptions}}" value="{{moyIndex}}" bind:change="onMoyChange">
          <view class="setting-row">
            <view class="setting-copy">
              <text class="setting-title">执行月份</text>
              <text class="setting-desc">每年会在这个月份执行</text>
            </view>
            <view class="setting-value-wrap">
              <text class="setting-value">{{moyOptions[moyIndex]}}</text>
              <text class="setting-arrow">›</text>
            </view>
          </view>
        </picker>

        <view class="divider"></view>
        <picker mode="selector" range="{{domOptions}}" value="{{domIndex}}" bind:change="onDomChange">
          <view class="setting-row">
            <view class="setting-copy">
              <text class="setting-title">执行日期</text>
              <text class="setting-desc">每年在这一天执行</text>
            </view>
            <view class="setting-value-wrap">
              <text class="setting-value">{{domOptions[domIndex]}}</text>
              <text class="setting-arrow">›</text>
            </view>
          </view>
        </picker>
      </view>
    </view>

    <text class="section-title">生效范围</text>
    <view class="group-card">
      <picker mode="date" value="{{startDate}}" bind:change="onStartDateChange">
        <view class="setting-row">
          <view class="setting-copy">
            <text class="setting-title">开始日期</text>
            <text class="setting-desc">从这一天开始生效</text>
          </view>
          <view class="setting-value-wrap">
            <text class="setting-value">{{startDate}}</text>
            <text class="setting-arrow">›</text>
          </view>
        </view>
      </picker>

      <view class="divider"></view>

      <picker mode="date" value="{{endDate || startDate}}" bind:change="onEndDateChange">
        <view class="setting-row">
          <view class="setting-copy">
            <text class="setting-title">结束日期</text>
            <text class="setting-desc">不设置则长期有效</text>
          </view>
          <view class="setting-value-wrap">
            <text class="setting-value {{endDate ? '' : 'setting-value-muted'}}">{{endDate || '不限'}}</text>
            <text class="setting-arrow">›</text>
          </view>
        </view>
      </picker>

      <view wx:if="{{endDate}}" class="divider"></view>

      <view wx:if="{{endDate}}" class="setting-row">
        <view class="setting-copy">
          <text class="setting-title">清除结束日期</text>
          <text class="setting-desc">恢复为长期有效</text>
        </view>
        <view class="ghost-action" bind:tap="onClearEndDate">清除</view>
      </view>
    </view>

    <view class="page-gap"></view>
  </scroll-view>

  <view class="bottom-bar">
    <view class="save-btn" bind:tap="onSave">{{saveButtonText}}</view>
  </view>
</view>
