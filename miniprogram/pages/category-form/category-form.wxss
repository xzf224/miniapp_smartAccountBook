.page-root {
  min-height: 100vh;
  background: var(--color-bg-page);
  display: flex;
  flex-direction: column;
}

.nav-save {
  padding: 10rpx 0;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.page-scroll {
  flex: 1;
  min-height: 0;
}

.page-content {
  padding: 16rpx 20rpx calc(24rpx + env(safe-area-inset-bottom));
}

.type-tabs {
  display: flex;
  padding: 4rpx;
  border-radius: 999rpx;
  background: #f1f2f5;
}

.type-tab {
  flex: 1;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  font-weight: 500;
}

.type-tab.active {
  background: var(--color-primary);
  color: #ffffff;
  box-shadow: 0 8rpx 16rpx rgba(255, 125, 0, 0.18);
}

.section {
  margin-top: 24rpx;
}

.section-title {
  display: block;
  margin-bottom: 16rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.icon-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -6rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-card);
  padding: 12rpx 6rpx;
}

.icon-item {
  width: 20%;
  padding: 6rpx;
  box-sizing: border-box;
}

.icon-item-text {
  height: 72rpx;
  border-radius: 36rpx;
  background: var(--color-bg-card);
  border: 2rpx solid var(--color-border);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: #667085;
}

.icon-item.selected .icon-item-text {
  background: var(--color-primary);
  border-color: var(--color-primary);
  color: #ffffff;
}

.color-row {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
}

.color-item {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.color-item.selected {
  box-shadow: 0 0 0 4rpx #fff, 0 0 0 6rpx var(--color-primary);
}

.color-check {
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
}

.form-input,
.money-input {
  height: 96rpx;
  padding: 0 24rpx;
  border-radius: var(--radius-card);
  background: var(--color-bg-card);
  border: 2rpx solid var(--color-border);
  box-sizing: border-box;
}

.form-input {
  font-size: 28rpx;
  color: var(--color-text-primary);
}

.money-input {
  display: flex;
  align-items: center;
}

.money-symbol {
  margin-right: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.money-field {
  flex: 1;
  height: 100%;
  font-size: 28rpx;
  color: var(--color-text-primary);
}

.save-button {
  height: 96rpx;
  margin-top: 28rpx;
  border-radius: var(--radius-btn);
  background: var(--color-primary);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 32rpx rgba(255, 125, 0, 0.18);
  width: 100%;
  box-sizing: border-box;
}
