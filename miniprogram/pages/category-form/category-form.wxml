<view class="page-root">
  <navigation-bar title="添加分类" back="{{true}}" background="#F6F7F9">
    <view slot="right" class="nav-save" bindtap="onSaveCategory">保存</view>
  </navigation-bar>

  <scroll-view scroll-y class="page-scroll">
    <view class="page-content">
      <view class="type-tabs">
        <view
          class="type-tab {{typeIndex === index ? 'active' : ''}}"
          wx:for="{{types}}"
          wx:key="*this"
          data-index="{{index}}"
          bindtap="onTypeChange"
        >
          {{item}}
        </view>
      </view>

      <view class="section">
        <text class="section-title">选择图标</text>
        <view class="icon-grid">
          <view
            class="icon-item {{selectedIcon === item ? 'selected' : ''}}"
            wx:for="{{iconOptions}}"
            wx:key="*this"
            data-icon="{{item}}"
            bindtap="onSelectIcon"
          >
            <text class="icon-item-text">{{item}}</text>
          </view>
        </view>
      </view>

      <view class="section">
        <text class="section-title">选择颜色</text>
        <view class="color-row">
          <view
            class="color-item {{selectedColor === item ? 'selected' : ''}}"
            wx:for="{{colorOptions}}"
            wx:key="*this"
            data-color="{{item}}"
            bindtap="onSelectColor"
            style="background: {{item}};"
          >
            <text wx:if="{{selectedColor === item}}" class="color-check">✓</text>
          </view>
        </view>
      </view>

      <view class="section">
        <text class="section-title">分类名称</text>
        <input
          class="form-input"
          placeholder="宠物"
          value="{{newName}}"
          maxlength="6"
          bindinput="onNameInput"
        />
      </view>

      <view class="section">
        <text class="section-title">预算限额（可选）</text>
        <view class="money-input">
          <text class="money-symbol">¥</text>
          <input
            class="money-field"
            type="digit"
            placeholder="设置每月预算"
            value="{{budgetYuan}}"
            bindinput="onBudgetInput"
          />
        </view>
      </view>

      <view class="save-button" bindtap="onSaveCategory">保存分类</view>
    </view>
  </scroll-view>
</view>
