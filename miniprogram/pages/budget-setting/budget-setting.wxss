/* ===== Page root ===== */
.page-root {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--color-bg-page);
}

.page-body {
  flex: 1;
  height: 0;
  background: var(--color-bg-page);
}

.bs-overview {
  margin: 20rpx 24rpx 0;
  padding: 30rpx;
  border-radius: var(--radius-card);
  background: linear-gradient(180deg, #fffaf3 0%, #ffffff 100%);
  border: 2rpx solid rgba(255, 138, 0, 0.1);
  box-shadow: 0 12rpx 28rpx rgba(15, 23, 42, 0.05);
}

.bs-overview-warning {
  background: linear-gradient(180deg, #fff8ef 0%, #ffffff 100%);
  border-color: rgba(255, 138, 0, 0.16);
}

.bs-overview-danger {
  background: linear-gradient(180deg, #fff5f5 0%, #ffffff 100%);
  border-color: rgba(250, 81, 81, 0.16);
}

.bs-overview-neutral {
  background: linear-gradient(180deg, #fafbfc 0%, #ffffff 100%);
  border-color: rgba(148, 163, 184, 0.16);
}

.bs-overview-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.bs-overview-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.bs-overview-hint {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--color-text-secondary);
}

.bs-overview-badge {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.bs-overview-badge-normal {
  background: rgba(76, 175, 80, 0.12);
  color: #2e7d32;
}

.bs-overview-badge-warning {
  background: rgba(255, 138, 0, 0.14);
  color: var(--color-primary);
}

.bs-overview-badge-danger {
  background: rgba(250, 81, 81, 0.12);
  color: #fa5151;
}

.bs-overview-badge-neutral {
  background: rgba(148, 163, 184, 0.14);
  color: #64748b;
}

.bs-overview-grid {
  display: flex;
  gap: 14rpx;
  margin-top: 22rpx;
}

.bs-overview-metric {
  flex: 1;
  min-width: 0;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.86);
}

.bs-overview-label {
  display: block;
  font-size: 20rpx;
  color: var(--color-text-secondary);
}

.bs-overview-value {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.bs-overview-value-pos {
  color: var(--color-primary);
}

.bs-overview-value-neg {
  color: var(--color-expense);
}

/* ===== Card ===== */
.bs-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-card);
  margin: 20rpx 24rpx 0;
  padding: 30rpx 28rpx 16rpx;
  display: flex;
  flex-direction: column;
  box-shadow: 0 10rpx 26rpx rgba(15, 23, 42, 0.05);
}

.bs-card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  padding-bottom: 8rpx;
}

/* ===== Shared row ===== */
.bs-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.bs-row:last-child {
  border-bottom: none;
}

.bs-row-no-border {
  border-bottom: none;
}

.bs-row-label {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  flex: 1;
}

.bs-row-right {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
}

.bs-row-value {
  font-size: 28rpx;
  color: var(--color-text-primary);
  font-weight: 500;
  white-space: nowrap;
}

.bs-chevron {
  font-size: 32rpx;
  color: #C8C8C8;
  line-height: 1;
}

/* ===== Total budget amount row ===== */
.bs-amount-left {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: 4rpx;
}

.bs-currency {
  font-size: 36rpx;
  color: var(--color-text-primary);
  font-weight: 500;
}

.bs-amount-num {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  line-height: 1;
  white-space: nowrap;
}

.bs-amount-input {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  width: 280rpx;
  border-bottom: 2rpx solid var(--color-primary);
  padding-bottom: 4rpx;
  white-space: nowrap;
}

.bs-amount-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.bs-action-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 56rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: var(--color-text-primary);
  background: #f6f7f9;
}

.bs-action-chip-clear {
  background: rgba(250, 81, 81, 0.1);
}

.bs-action-icon {
  width: 26rpx;
  height: 26rpx;
  flex-shrink: 0;
}

.bs-action-text {
  font-size: 22rpx;
  color: var(--color-text-primary);
  line-height: 1;
}

.bs-action-text-clear {
  color: var(--color-expense);
}

.bs-inline-tip {
  margin-top: -6rpx;
  padding: 0 0 18rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.bs-inline-tip-text {
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--color-text-secondary);
}

.bs-edit-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.bs-pencil-icon {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.45;
}

/* ===== Alert threshold ===== */
.bs-threshold-display {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
}

.bs-threshold-value {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-primary);
  white-space: nowrap;
}

.bs-threshold-edit {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 4rpx;
}

.bs-threshold-input {
  width: 80rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-primary);
  border-bottom: 2rpx solid var(--color-primary);
  text-align: right;
  padding-bottom: 2rpx;
}

.bs-threshold-pct {
  font-size: 28rpx;
  color: var(--color-primary);
}

.bs-alert-desc {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
  padding: 0 0 20rpx;
}

.bs-alert-note {
  display: block;
  margin-top: -4rpx;
  font-size: 22rpx;
  color: #8a9099;
  line-height: 1.6;
}

/* ===== Category budget card header ===== */
.bs-add-link {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: var(--color-primary);
  font-weight: 600;
  background: rgba(255, 138, 0, 0.12);
}

/* ===== Inline add form ===== */
.bs-add-form {
  background: linear-gradient(180deg, #fffaf3 0%, #ffffff 100%);
  border-radius: var(--radius-card);
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-bottom: 12rpx;
  border: 2rpx solid rgba(255, 138, 0, 0.1);
}

.bs-add-form-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.bs-add-form-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.bs-add-form-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--color-text-secondary);
}

.bs-add-form-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
}

.bs-add-form-label {
  font-size: 28rpx;
  color: var(--color-text-primary);
  font-weight: 600;
}

.bs-add-field {
  padding: 22rpx 24rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.82);
  box-shadow: inset 0 0 0 1rpx rgba(255, 138, 0, 0.06);
}

.bs-picker-display {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 4rpx;
}

.bs-picker-display-block {
  margin-top: 14rpx;
  justify-content: space-between;
  gap: 16rpx;
}

.bs-picker-copy {
  min-width: 0;
  flex: 1;
}

.bs-picker-value {
  font-size: 28rpx;
  color: var(--color-text-primary);
  font-weight: 600;
  white-space: nowrap;
}

.bs-picker-hint {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--color-text-secondary);
}

.bs-add-input-wrap {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 4rpx;
}

.bs-add-input-wrap-block {
  margin-top: 14rpx;
  padding: 4rpx 0;
}

.bs-currency-sm {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.bs-add-input {
  width: 100%;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  text-align: right;
  border-bottom: 2rpx solid rgba(255, 138, 0, 0.16);
  padding-bottom: 8rpx;
}

.bs-add-form-actions {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  margin-top: 4rpx;
}

.bs-cancel-btn {
  flex: 1;
  height: 72rpx;
  border-radius: 36rpx;
  border: 1rpx solid var(--color-border);
  display: flex;
  align-items: center;
  justify-content: center;
}

.bs-cancel-btn-text {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.bs-confirm-btn {
  flex: 2;
  height: 72rpx;
  border-radius: 36rpx;
  background: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
}

.bs-confirm-btn-text {
  font-size: 28rpx;
  color: #fff;
  font-weight: 600;
}

/* ===== Category budget list ===== */
.bs-cat-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding-bottom: 16rpx;
}

.bs-empty-card {
  margin-bottom: 16rpx;
  padding: 28rpx 24rpx;
  border-radius: 22rpx;
  background: linear-gradient(180deg, #fafbfc 0%, #ffffff 100%);
  border: 1rpx dashed rgba(148, 163, 184, 0.24);
}

.bs-empty-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.bs-empty-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--color-text-secondary);
}

.bs-cat-item {
  background: #f8f8f8;
  border-radius: var(--radius-card);
  padding: 24rpx 28rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.bs-cat-item-warning {
  background: rgba(255, 138, 0, 0.08);
}

.bs-cat-item-danger {
  background: rgba(250, 81, 81, 0.08);
}

/* Top row */
.bs-cat-top {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.bs-cat-left {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
  flex: 1;
  min-width: 0;
}

.bs-cat-accent {
  width: 8rpx;
  height: 64rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.bs-cat-copy {
  display: flex;
  flex-direction: column;
  min-width: 0;
  flex: 1;
  padding-right: 8rpx;
}

.bs-cat-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.bs-cat-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.bs-cat-icon-text {
  font-size: 26rpx;
  font-weight: 700;
}

.bs-cat-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  min-width: 0;
}

.bs-cat-rank {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.bs-cat-status {
  margin-top: 6rpx;
  font-size: 20rpx;
  font-weight: 600;
}

.bs-cat-status-normal {
  color: var(--color-primary);
}

.bs-cat-status-warning {
  color: #d97706;
}

.bs-cat-status-danger {
  color: #fa5151;
}

.bs-cat-right {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.bs-cat-budget-num {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  white-space: nowrap;
}

.bs-cat-budget-input {
  width: 140rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  text-align: right;
  border-bottom: 2rpx solid var(--color-primary);
  padding-bottom: 2rpx;
}

/* Progress bar */
.bs-progress-track {
  height: 8rpx;
  background: var(--color-border);
  border-radius: 4rpx;
  overflow: hidden;
}

.bs-progress-fill {
  height: 100%;
  border-radius: 4rpx;
  min-width: 0;
}

.bs-progress-over {
  background: var(--color-expense) !important;
}

/* Bottom row */
.bs-cat-bottom {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.bs-spent-text {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.bs-delete-btn {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: var(--color-expense);
  background: rgba(250, 81, 81, 0.1);
}

/* ===== Summary rows ===== */
.bs-summary-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0 8rpx;
  border-top: 1rpx solid var(--color-border);
  margin-top: 4rpx;
}

.bs-summary-left {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.bs-summary-right {
  font-size: 24rpx;
  color: var(--color-primary);
  font-weight: 600;
}

.bs-unallocated-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding-bottom: 8rpx;
}

.bs-unallocated-label {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.bs-unallocated-amount {
  font-size: 24rpx;
  font-weight: 600;
}

.bs-unallocated-pos {
  color: var(--color-income);
}

.bs-unallocated-neg {
  color: var(--color-expense);
}

/* ===== Save button ===== */
.bs-save-btn {
  margin: 24rpx 24rpx 0;
  height: 88rpx;
  border-radius: 44rpx;
  background: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 26rpx rgba(255, 125, 0, 0.2);
}

.bs-save-btn-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
}

.bs-bottom-gap {
  height: 48rpx;
}
