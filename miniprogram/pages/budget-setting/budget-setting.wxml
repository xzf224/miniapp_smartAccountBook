<view class="page-root">
  <navigation-bar title="预算设置" back="{{true}}" />
  <scroll-view scroll-y class="page-body">

    <view class="bs-overview bs-overview-{{overviewStatusTone}}">
      <view class="bs-overview-head">
        <view>
          <text class="bs-overview-title">本月预算配置</text>
          <text class="bs-overview-hint">{{overviewHintText}}</text>
        </view>
        <text class="bs-overview-badge bs-overview-badge-{{overviewStatusTone}}">{{overviewStatusText}}</text>
      </view>
      <view class="bs-overview-grid">
        <view class="bs-overview-metric">
          <text class="bs-overview-label">总预算</text>
          <text class="bs-overview-value">{{currencySymbol}}{{totalBudgetDisplay}}</text>
        </view>
        <view class="bs-overview-metric">
          <text class="bs-overview-label">分类合计</text>
          <text class="bs-overview-value">{{currencySymbol}}{{totalCatBudgetDisplay}}</text>
        </view>
        <view class="bs-overview-metric">
          <text class="bs-overview-label">未分配</text>
          <text class="bs-overview-value {{unallocatedPositive ? 'bs-overview-value-pos' : 'bs-overview-value-neg'}}">{{unallocatedPositive ? '' : '-'}}{{currencySymbol}}{{unallocatedDisplay}}</text>
        </view>
      </view>
    </view>

    <!-- ===== Section 1: 总预算设置 ===== -->
    <view class="bs-card">
      <text class="bs-card-title">总预算设置</text>

      <!-- Amount row -->
      <view class="bs-row bs-row-no-border">
        <view class="bs-amount-left">
          <text class="bs-currency">{{currencySymbol}}</text>
          <text wx:if="{{!editingTotal}}" class="bs-amount-num">{{totalBudgetDisplay}}</text>
          <input wx:else
            class="bs-amount-input"
            type="digit"
            placeholder="请输入金额"
            placeholder-style="font-size: 28rpx; font-weight: 500; color: #C8C8C8;"
            value="{{editTotalValue}}"
            focus="{{editingTotal}}"
            bind:input="onTotalInput"
            bind:blur="onTotalBlur"
            bind:confirm="onTotalConfirm"
          />
        </view>
        <view class="bs-amount-actions">
          <view class="bs-action-chip" bind:tap="onEditTotal">
            <image class="bs-action-icon" src="/images/new/pencil.png" mode="aspectFit" />
          </view>
          <view wx:if="{{totalBudgetFen > 0}}" class="bs-action-chip bs-action-chip-clear" bind:tap="onClearTotal">
            <image class="bs-action-icon" src="/images/new/clear.png" mode="aspectFit" />
          </view>
        </view>
      </view>
      <view class="bs-inline-tip">
        <text class="bs-inline-tip-text">总预算可不设置；如已设置，金额不能低于分类预算之和。</text>
      </view>

      <!-- Cycle row -->
      <view class="bs-row">
        <text class="bs-row-label">预算周期</text>
        <view class="bs-row-right">
          <text class="bs-row-value">当前仅支持每月</text>
        </view>
      </view>
    </view>

    <!-- ===== Section 2: 预警设置 ===== -->
    <view class="bs-card">
      <text class="bs-card-title">预警设置</text>

      <!-- Threshold row -->
      <view class="bs-row">
        <text class="bs-row-label">预警阈值</text>
        <view class="bs-row-right">
          <view wx:if="{{!editingThreshold}}" class="bs-threshold-display" bind:tap="onEditThreshold">
            <text class="bs-threshold-value">{{alertThreshold}}%</text>
            <image class="bs-pencil-icon" src="/images/new/pencil.png" mode="aspectFit" />
          </view>
          <view wx:else class="bs-threshold-edit">
            <input
              class="bs-threshold-input"
              type="number"
              placeholder="1-100"
              value="{{editThresholdValue}}"
              focus="{{editingThreshold}}"
              bind:input="onThresholdInput"
              bind:blur="onThresholdBlur"
              bind:confirm="onThresholdConfirm"
            />
            <text class="bs-threshold-pct">%</text>
          </view>
        </view>
      </view>

      <!-- Description -->
      <text class="bs-alert-desc">当支出达到预算的{{alertThreshold}}%时提醒您</text>

      <!-- Toggle row -->
      <view class="bs-row">
        <text class="bs-row-label">开启预算提醒</text>
        <switch
          checked="{{alertEnabled}}"
          color="var(--color-primary)"
          bind:change="onAlertToggle"
        />
      </view>
      <text class="bs-alert-note">开启后，新增支出达到总预算或分类预算阈值、或发生超支时会弹窗提醒；首页和预算页也会同步显示提醒状态。</text>
    </view>

    <!-- ===== Section 3: 分类预算 ===== -->
    <view class="bs-card">
      <!-- Card header -->
      <view class="bs-row bs-cat-header">
        <text class="bs-card-title">分类预算</text>
        <view class="bs-add-link" bind:tap="onToggleAddForm">+ 添加分类预算</view>
      </view>

      <!-- Inline add form -->
      <view wx:if="{{showAddForm}}" class="bs-add-form">
        <view class="bs-add-form-head">
          <view>
            <text class="bs-add-form-title">新增分类预算</text>
            <text class="bs-add-form-desc">还可添加 {{availableCategories.length}} 个分类，建议优先补齐高频支出项。</text>
          </view>
        </view>

        <view class="bs-add-field">
          <text class="bs-add-form-label">选择分类</text>
          <picker
            mode="selector"
            range="{{availableCategories}}"
            value="{{addPickerIndex}}"
            bind:change="onAddPickerChange"
          >
            <view class="bs-picker-display bs-picker-display-block">
              <view class="bs-picker-copy">
                <text class="bs-picker-value">{{availableCategories[addPickerIndex]}}</text>
                <text class="bs-picker-hint">点击切换分类</text>
              </view>
              <text class="bs-chevron">›</text>
            </view>
          </picker>
        </view>

        <view class="bs-add-field">
          <text class="bs-add-form-label">预算金额</text>
          <view class="bs-add-input-wrap bs-add-input-wrap-block">
            <text class="bs-currency bs-currency-sm">{{currencySymbol}}</text>
            <input
              class="bs-add-input"
              type="digit"
              placeholder="请输入金额"
              value="{{addBudgetValue}}"
              bind:input="onAddBudgetInput"
            />
          </view>
        </view>

        <view class="bs-add-form-actions">
          <view class="bs-cancel-btn" bind:tap="onCancelAdd">
            <text class="bs-cancel-btn-text">取消</text>
          </view>
          <view class="bs-confirm-btn" bind:tap="onConfirmAdd">
            <text class="bs-confirm-btn-text">确认</text>
          </view>
        </view>
      </view>

      <!-- Category budget list -->
      <view class="bs-cat-list" wx:if="{{catBudgets.length > 0}}">
        <view
          class="bs-cat-item bs-cat-item-{{item.statusTone}}"
          wx:for="{{catBudgets}}"
          wx:key="category"
        >
          <!-- Top row: icon+name | amount+pencil -->
          <view class="bs-cat-top">
            <view class="bs-cat-left">
              <view class="bs-cat-accent" style="background: {{item.accentColor}};"></view>
              <view
                class="bs-cat-icon-wrap"
                style="background: {{item.iconBgRgba}};"
              >
                <text class="bs-cat-icon-text" style="color: {{item.iconColor}};">{{item.iconText}}</text>
              </view>
              <view class="bs-cat-copy">
                <view class="bs-cat-title-row">
                  <text class="bs-cat-name">{{item.category}}</text>
                  <text
                    class="bs-cat-rank"
                    wx:if="{{item.isPriority}}"
                    style="background: {{item.iconBgRgba}}; color: {{item.iconColor}};"
                  >TOP {{item.rank}}</text>
                </view>
                <text class="bs-cat-status bs-cat-status-{{item.statusTone}}">{{item.statusText}}</text>
              </view>
            </view>
            <view class="bs-cat-right">
              <text wx:if="{{!item.editingBudget}}" class="bs-cat-budget-num">{{currencySymbol}}{{item.budgetYuan}}</text>
              <input wx:else
                class="bs-cat-budget-input"
                type="digit"
                value="{{item.editBudgetValue}}"
                focus="{{item.editingBudget}}"
                data-index="{{index}}"
                bind:input="onCatBudgetInput"
                bind:blur="onCatBudgetBlur"
                bind:confirm="onCatBudgetConfirm"
              />
              <view class="bs-edit-btn" data-index="{{index}}" bind:tap="onEditCatBudget">
                <image class="bs-pencil-icon" src="/images/new/pencil.png" mode="aspectFit" />
              </view>
            </view>
          </view>

          <!-- Progress bar -->
          <view class="bs-progress-track">
            <view
              class="bs-progress-fill {{item.isOver ? 'bs-progress-over' : ''}}"
              style="width: {{item.progressPct}}%; background: {{item.isOver ? '' : item.iconColor}};"
            />
          </view>

          <!-- Bottom row: spent | delete -->
          <view class="bs-cat-bottom">
            <text class="bs-spent-text">已用 {{currencySymbol}}{{item.spentYuan}} ({{item.spentPct}}%)</text>
            <view class="bs-delete-btn" data-index="{{index}}" bind:tap="onDeleteCatBudget">删除</view>
          </view>
        </view>
      </view>
      <view wx:else class="bs-empty-card">
        <text class="bs-empty-title">还没有分类预算</text>
        <text class="bs-empty-desc">分类预算可以单独设置，不依赖总预算。可先添加常用支出分类。</text>
      </view>

      <!-- Summary rows -->
      <view class="bs-summary-row">
        <text class="bs-summary-left">分类预算合计: {{currencySymbol}}{{totalCatBudgetDisplay}}</text>
        <text class="bs-summary-right">总预算: {{currencySymbol}}{{totalBudgetDisplay}}</text>
      </view>

      <view class="bs-unallocated-row">
        <text class="bs-unallocated-label">未分配预算: </text>
        <text class="bs-unallocated-amount {{unallocatedPositive ? 'bs-unallocated-pos' : 'bs-unallocated-neg'}}">
          {{unallocatedPositive ? '' : '-'}}{{currencySymbol}}{{unallocatedDisplay}}
        </text>
      </view>
    </view>

    <!-- ===== Save button ===== -->
    <view class="bs-save-btn" bind:tap="onSave">
      <text class="bs-save-btn-text">保存设置</text>
    </view>

    <view class="bs-bottom-gap" />
  </scroll-view>
</view>
