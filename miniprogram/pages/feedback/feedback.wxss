.page-root {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--color-bg-page);
}

.page-body {
  flex: 1;
  height: 0;
  background: var(--color-bg-page);
}

.hero-card {
  margin: 24rpx 24rpx 0;
  padding: 22rpx 22rpx 40rpx;
  border-radius: var(--radius-card);
  background: linear-gradient(135deg, rgba(255, 149, 0, 0.13), rgba(255, 125, 0, 0.05));
  border: 1rpx solid rgba(255, 125, 0, 0.14);
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  box-sizing: border-box;
}

.hero-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.hero-desc {
  font-size: 22rpx;
  line-height: 1.5;
  color: #7a5f3a;
}

.hero-meta-row {
  display: flex;
  gap: 12rpx;
}

.hero-meta-pill {
  flex: 1;
  min-width: 0;
  padding: 14rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.78);
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.hero-meta-kicker {
  font-size: 19rpx;
  color: var(--color-text-secondary);
}

.hero-meta-value {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.section-title {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
  margin: 20rpx 24rpx 8rpx;
  letter-spacing: 1rpx;
}

.group-card {
  margin: 0 24rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-card);
  box-sizing: border-box;
}

.type-group {
  padding: 18rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.type-chip {
  min-width: 172rpx;
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
  background: #f4f5f7;
  border: 1rpx solid transparent;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.type-chip-active {
  background: rgba(255, 125, 0, 0.09);
  border-color: rgba(255, 125, 0, 0.26);
}

.type-chip-text {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.type-chip-text-active {
  font-weight: 600;
  color: var(--color-primary);
}

.form-card {
  padding: 22rpx 24rpx;
}

.feedback-textarea {
  width: 100%;
  min-height: 220rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--color-text-primary);
  box-sizing: border-box;
}

.contact-input {
  height: 88rpx;
  font-size: 28rpx;
  color: var(--color-text-primary);
}

.feedback-placeholder {
  color: #b8bec9;
}

.field-footer {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.field-hint {
  display: block;
  font-size: 21rpx;
  line-height: 1.5;
  color: var(--color-text-secondary);
}

.field-count {
  flex-shrink: 0;
  font-size: 21rpx;
  color: #98a2b3;
}

.privacy-card {
  margin: 20rpx 24rpx 0;
  padding: 22rpx 24rpx;
  border-radius: var(--radius-card);
  background: rgba(32, 201, 151, 0.08);
  border: 1rpx solid rgba(32, 201, 151, 0.12);
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.privacy-title {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.privacy-desc {
  font-size: 22rpx;
  line-height: 1.6;
  color: #4d6b61;
}

.submit-btn {
  margin: 28rpx 24rpx 0;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #ff9a1f, #ff7d00);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}

.submit-btn::after {
  border: none;
}

.page-gap {
  height: 48rpx;
}
